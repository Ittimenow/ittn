---
import { aiServiceGroup, serviceGroups, supportService } from '../data/service-navigation';

const year = new Date().getFullYear();

const sections = [
	...serviceGroups.map((group) => ({
		title: group.title,
		links: group.items.map((item) => ({ title: item.title, href: item.href })),
	})),
	{
		title: aiServiceGroup.title,
		links: aiServiceGroup.items.map((item) => ({ title: item.title, href: item.href })),
	},
	{
		title: 'Сопровождение',
		links: [{ title: supportService.title, href: supportService.href }],
	},
	{
		title: 'Компания',
		links: [
			{ title: 'Кейсы', href: '/cases' },
			{ title: 'Блог', href: '/posts' },
			{ title: 'О\u00A0нас', href: '/about' },
		],
	},
];
---

<footer class="mt-32 border-t border-white/15 bg-[#111111] text-white">
	<div class="mx-auto max-w-[1440px] px-6 py-16">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-[1.25fr_repeat(5,minmax(0,1fr))]">
			<div>
				<a href="/" class="inline-flex items-center" aria-label="IT TIME NOW">
					<img
						src="/brand/ittn-logo.webp"
						alt="IT TIME NOW"
						width="1328"
						height="157"
						class="block h-auto w-[271px] max-w-full object-contain brightness-0 invert"
						loading="lazy"
						decoding="async"
					/>
				</a>
				<p class="mt-4 max-w-xs text-sm leading-6 text-white/60">
					Цифровые системы эффективного бизнеса. С&nbsp;2013&nbsp;года.
				</p>
			</div>

			{sections.map((s) => (
				<div>
					<p class="mb-3 text-xs font-bold uppercase text-white/60">
						{s.title}
					</p>
					<ul class="space-y-2 text-sm">
						{s.links.map((l) => (
							<li>
								<a
									href={l.href}
									class="font-medium text-white transition hover:text-[color:var(--ds-secondary)]"
								>
									{l.title}
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>

		<div
			class="mt-12 flex flex-col gap-4 border-t border-white/15 pt-6 text-sm text-white/60 sm:flex-row sm:items-center sm:justify-between"
		>
			<p>© 2013–{year} ittimenow.com</p>
			<div class="flex flex-wrap items-center gap-x-6 gap-y-2">
				<a
					href="/oferta-ooo-vok-torg-na-sertifikat-1s-bit"
					class="transition hover:text-[color:var(--ds-secondary)]"
				>
					Оферта Битрикс24.Маркет
				</a>
				<a
					href="/oferta-ip-podobnyi-jurii-semenovich-na-zakljuchenie-sublicenzionnogo-dogovora"
					class="transition hover:text-[color:var(--ds-secondary)]"
				>
					Сублицензионная оферта
				</a>
				<a href="mailto:hello@ittimenow.com" class="transition hover:text-[color:var(--ds-secondary)]">
					hello@ittimenow.com
				</a>
				<span>Москва, Варшавское шоссе, 28А</span>
			</div>
		</div>
	</div>
</footer>
