---
const year = new Date().getFullYear();

const sections = [
	{
		title: 'Разработка',
		links: [
			{ title: 'Сайты и\u00A0сервисы', href: '/services/web' },
			{ title: 'Искусственный интеллект', href: '/services/ai' },
		],
	},
	{
		title: 'Автоматизация',
		links: [
			{ title: 'Битрикс24', href: '/services/bitrix24' },
			{ title: 'РосБизнесСофт', href: '/services/rbs' },
			{ title: 'ЭЛМА', href: '/services/elma' },
		],
	},
	{
		title: 'Компания',
		links: [
			{ title: 'Кейсы', href: '/cases' },
			{ title: 'Блог', href: '/posts' },
			{ title: 'О\u00A0нас', href: '/about' },
		],
	},
];
---

<footer class="mt-32 border-t border-[color:var(--ds-border)] bg-[color:var(--ds-soft)]">
	<div class="mx-auto max-w-[1440px] px-6 py-16">
		<div class="grid gap-10 md:grid-cols-4">
			<div>
				<a href="/" class="inline-flex items-center" aria-label="IT TIME NOW">
					<img
						src="/brand/ittn-logo.webp"
						alt="IT TIME NOW"
						class="h-[32px] w-auto"
						loading="lazy"
						decoding="async"
					/>
				</a>
				<p class="mt-4 max-w-xs text-sm leading-6 text-[color:var(--ds-muted)]">
					Цифровые системы эффективного бизнеса. С&nbsp;2013&nbsp;года.
				</p>
			</div>

			{sections.map((s) => (
				<div>
					<p class="mb-3 text-xs font-bold uppercase text-[color:var(--ds-muted)]">
						{s.title}
					</p>
					<ul class="space-y-2 text-sm">
						{s.links.map((l) => (
							<li>
								<a
									href={l.href}
									class="font-medium text-[color:var(--ds-ink)] transition hover:text-[color:var(--ds-primary)]"
								>
									{l.title}
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>

		<div
			class="mt-12 flex flex-col gap-4 border-t border-[color:var(--ds-border)] pt-6 text-sm text-[color:var(--ds-muted)] sm:flex-row sm:items-center sm:justify-between"
		>
			<p>© 2013–{year} ittimenow.com</p>
			<div class="flex flex-wrap items-center gap-x-6 gap-y-2">
				<a href="tel:+74951335888" class="hover:text-[color:var(--ds-primary)]">
					+7&nbsp;(495)&nbsp;133-58-88
				</a>
				<a href="mailto:hello@ittimenow.com" class="hover:text-[color:var(--ds-primary)]">
					hello@ittimenow.com
				</a>
				<span>Москва, Варшавское шоссе, 28А</span>
			</div>
		</div>
	</div>
</footer>
