---
import type { ComponentProps } from 'astro/types';
import DevelopmentServicePage from './DevelopmentServicePage.astro';

const problems: ComponentProps<typeof DevelopmentServicePage>['problems'] = [
	{
		icon: 'message',
		title: 'Предложение сложно понять',
		text: 'Посетитель видит много информации, но не понимает, что именно вы предлагаете, кому подходит услуга и почему стоит обратиться к вам.',
	},
	{
		icon: 'shield',
		title: 'Сайт не вызывает доверия',
		text: 'Компания выросла, появились новые продукты и сильные проекты, а сайт продолжает выглядеть так, будто его не обновляли несколько лет.',
	},
	{
		icon: 'filter',
		title: 'Трафик есть, заявок мало',
		text: 'Пользователь не находит нужную информацию, теряется между разделами или не понимает следующий шаг.',
	},
	{
		icon: 'layers',
		title: 'Сайт трудно развивать',
		text: 'Любое изменение требует разработчика, страницы собраны без единой системы, а платформа ограничивает новые сценарии.',
	},
];

const offerings: ComponentProps<typeof DevelopmentServicePage>['offerings'] = [
	{
		icon: 'rocket',
		title: 'Продающий лендинг',
		price: 'от 150 000 ₽',
		text: 'Одностраничный сайт для рекламы, проверки гипотезы, запуска продукта, мероприятия или отдельной услуги.',
		lists: [
			{
				title: 'В работу входит',
				items: ['анализ продукта и аудитории', 'структура и продающие тексты', 'прототип и индивидуальный дизайн', 'адаптивная разработка', 'формы, аналитика и базовые интеграции'],
			},
		],
	},
	{
		icon: 'briefcase',
		title: 'Корпоративный сайт',
		price: 'от 250 000 ₽',
		text: 'Многостраничный сайт, который представляет компанию, услуги, проекты и экспертизу и формирует основу для поискового продвижения.',
		lists: [
			{
				title: 'В работу входит',
				items: ['информационная архитектура', 'прототипы ключевых страниц', 'тексты основных блоков', 'UX/UI-дизайн и система компонентов', 'CMS и перенос материалов', 'формы, CRM и базовая SEO-подготовка'],
			},
		],
	},
	{
		icon: 'spark',
		title: 'Интерактивный имиджевый сайт',
		price: 'от 250 000 ₽',
		text: 'Выразительный сайт с анимацией, нестандартной навигацией, 3D-графикой или интерактивным сценарием.',
		lists: [
			{
				title: 'Подходит для',
				items: ['девелоперских и культурных проектов', 'технологичных компаний', 'премиальных продуктов', 'рекламных кампаний', 'брендов, которым важно выделиться'],
			},
		],
	},
	{
		icon: 'bar-chart',
		title: 'Интернет-магазин',
		price: 'от 400 000 ₽',
		text: 'Каталог и онлайн-продажи с поиском, фильтрами, корзиной, оплатой, доставкой и интеграцией с учётными системами.',
		featured: true,
		lists: [
			{
				title: 'В работу входит',
				items: ['каталог и карточки товаров', 'корзина и оформление заказа', 'личный кабинет покупателя', 'оплата и доставка', 'синхронизация цен и остатков', 'CRM/ERP и аналитика продаж'],
			},
		],
	},
];

const values: ComponentProps<typeof DevelopmentServicePage>['values'] = [
	{ icon: 'message', title: 'Понятное предложение', text: 'Пользователь быстро понимает ценность продукта и следующий шаг.' },
	{ icon: 'workflow', title: 'Путь до обращения', text: 'Структура ведёт от знакомства к заявке, заказу, оплате или регистрации.' },
	{ icon: 'settings', title: 'Управление контентом', text: 'Сотрудники самостоятельно обновляют согласованные разделы через CMS.' },
	{ icon: 'phone', title: 'Адаптивный интерфейс', text: 'Страницы корректно работают на телефонах, планшетах и компьютерах.' },
	{ icon: 'database', title: 'Связь с отделом продаж', text: 'Формы и источники обращений передаются в CRM и становятся частью процесса.' },
	{ icon: 'bar-chart', title: 'Основа для продвижения', text: 'Закладываем корректные адреса, метаданные, скорость и техническую SEO-подготовку.' },
];

const cases = [
	{
		title: 'Сны, билеты и немного магии фронтенда',
		href: '/cases/skazki-sna-frontend/',
		image: '/cases/skazki-sna-frontend/img-skazkisna-main-4x3-1.webp',
		text: 'Лендинг с игровой механикой, анимацией, покупкой билетов и генерацией именного видео после покупки.',
		result: '28,7 тыс. посетителей · 166 видеооткрыток',
	},
	{
		title: 'Имиджевый сайт строительной компании',
		href: '/cases/berkut-construction-website/',
		image: '/cases/berkut/main-image-skberkut.webp',
		text: 'Сайт с механикой текучего бетона, интерактивным счётчиком объёма работ и картой реализованных объектов.',
		result: 'Интерактивная механика под характер бренда',
	},
	{
		title: 'Сайт и материалы для «Энергии глубин»',
		href: '/cases/energy-depths-presentation-website/',
		image: '/cases/energy-depths/main-image-de.webp',
		text: 'Структура, дизайн и презентационные материалы для технологического проекта в сфере энергетики.',
		result: 'Единая подача для клиентов и партнёров',
	},
];

const process = [
	{ title: 'Брифинг', text: 'Обсуждаем бизнес, продукт, аудиторию, текущий сайт и ожидаемый результат.', result: 'Границы задачи и предварительный состав проекта.' },
	{ title: 'Аналитика', text: 'Изучаем материалы, конкурентов, поисковый спрос и пользовательские сценарии.', result: 'Концепция будущего сайта.' },
	{ title: 'Структура, тексты и прототип', text: 'Выстраиваем страницы, формулируем ключевое предложение и проверяем путь пользователя.', result: 'Согласованный интерактивный прототип.' },
	{ title: 'UX/UI-дизайн', text: 'Создаём визуальную концепцию, ключевые экраны и систему компонентов.', result: 'Макеты для компьютеров и мобильных устройств.' },
	{ title: 'Разработка', text: 'Верстаем интерфейс, подключаем CMS, формы, аналитику и согласованные интеграции.', result: 'Рабочая версия на тестовом контуре.' },
	{ title: 'Тестирование и запуск', text: 'Проверяем адаптивность, формы, контент, скорость и основные сценарии.', result: 'Опубликованный сайт, готовый к привлечению пользователей.' },
	{ title: 'Развитие', text: 'Добавляем страницы и функции, обновляем компоненты и улучшаем пользовательский путь.', result: 'Сайт развивается вместе с компанией.' },
];

const reasons = [
	{ title: 'Думаем о заявке после отправки формы', text: 'Учитываем, как обращение попадает в CRM, кто его получает и какие действия запускаются дальше.' },
	{ title: 'Проектируем до программирования', text: 'Сначала проверяем структуру, содержание и сценарии, чтобы не переносить ошибки в готовый интерфейс.' },
	{ title: 'Объединяем дизайн и разработку', text: 'UX/UI, frontend, backend и интеграции находятся в одной проектной команде.' },
	{ title: 'Работаем с нестандартной механикой', text: 'Можем реализовать анимацию, интерактив, расчёты, генераторы и сложные формы.' },
	{ title: 'Закладываем развитие', text: 'Используем компонентный подход, чтобы новые страницы и функции не требовали полной переделки.' },
];

const faqs: [string, string][] = [
	['Сколько стоит разработка сайта?', 'Лендинг начинается от 150 000 ₽, корпоративный и интерактивный сайт — от 250 000 ₽, интернет-магазин — от 400 000 ₽. Итог зависит от количества уникальных страниц, контента, дизайна, функций и интеграций.'],
	['Можно начать без технического задания?', 'Да. На старте достаточно описания бизнеса, задачи и доступных материалов. Структуру, требования и техническую часть мы сформируем в процессе аналитики.'],
	['Вы пишете тексты?', 'Для ключевых страниц формулируем структуру, ценностное предложение, заголовки и тексты блоков. Объём подготовки и переноса контента фиксируем в составе проекта.'],
	['Можно доработать существующий сайт?', 'Да. Сначала оцениваем архитектуру, CMS, код и инфраструктуру. Затем предлагаем редизайн, поэтапную доработку или новый проект, если переделка окажется неоправданной.'],
	['Сможем ли мы сами обновлять информацию?', 'Для контентных сайтов предусматриваем CMS. Состав редактируемых данных согласовываем до разработки.'],
	['Входит ли SEO?', 'В разработку входит базовая техническая подготовка: структура адресов, метаданные, адаптивность, скорость, карта сайта и возможность управления контентом. Поисковое продвижение является отдельной регулярной услугой.'],
];
---

<DevelopmentServicePage
	source="sites"
	breadcrumb="Разработка сайтов"
	title="Разрабатываем сайты, которые объясняют ценность и приводят обращения"
	intro={[
		'Проектируем структуру, формулируем предложение, создаём индивидуальный дизайн и разрабатываем сайт под задачи продаж, маркетинга и развития бренда.',
		'Подключаем CMS, аналитику, CRM, оплату и другие необходимые сервисы. После запуска помогаем развивать страницы и улучшать пользовательский путь.',
	]}
	cta="Получить оценку сайта"
	ctaNote="Расскажите о компании, продукте или текущем сайте. Предложим формат, состав работ и предварительный бюджет."
	trust={['Лендинги от 150 000 ₽', 'Структура, тексты, дизайн и разработка', 'CMS, аналитика и интеграции']}
	problemsHeading="Сайт должен помогать продавать, а не просто существовать"
	problems={problems}
	offeringsHeading="Подбираем формат под задачу и масштаб бизнеса"
	offeringsLead="Не предлагаем сложную платформу там, где достаточно компактного лендинга, и не собираем серьёзный интернет-магазин на случайном шаблоне."
	offerings={offerings}
	valuesHeading="Не набор страниц, а управляемый канал продаж"
	values={values}
	cases={cases}
	processHeading="От бизнес-задачи до опубликованного сайта"
	process={process}
	reasonsHeading="Думаем не только о внешнем виде сайта"
	reasons={reasons}
	faqs={faqs}
	related={[
		{ title: 'Веб-сервисы', href: '/services/web-services/', text: 'Личные кабинеты, B2B-порталы, MVP и внутренние системы.' },
		{ title: 'Интеграции', href: '/services/integrations/', text: 'Связь сайта с CRM, ERP, 1С, оплатой и внешними сервисами.' },
		{ title: 'Поддержка', href: '/services/support/', text: 'Правки, развитие, мониторинг и регулярные технические работы.' },
	]}
	finalHeading="Обсудим новый сайт или редизайн текущего?"
	finalText="Для первой встречи не нужны техническое задание и выбранная технология. Покажите текущие материалы или опишите продукт — предложим следующий шаг."
	finalCta="Получить предварительную оценку"
/>
