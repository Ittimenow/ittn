---
import { iconSrc, type IconName } from '../data/icons';

interface Props {
	name: IconName;
	class?: string;
	loading?: 'eager' | 'lazy';
}

const { name, class: className = 'h-[35px] w-[35px]', loading } = Astro.props;
---

<i
	class:list={['ui-icon', className]}
	data-ui-icon={name}
	aria-hidden="true"
>
	<img src={iconSrc(name)} width="512" height="512" alt="" loading={loading} decoding="async" draggable="false" />
</i>
