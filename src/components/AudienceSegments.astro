---
const segments = [
	{
		title: 'B2B-компании',
		text: 'Длинный цикл сделки, несколько этапов и участников, нужен контроль воронки и коммуникаций.',
		image: '/audience/audience-b2b.webp',
		imageAlt: 'Переговоры B2B-компаний',
	},
	{
		title: 'Производство',
		text: 'Важно связать заявку, планирование, производство, склад и отгрузку.',
		image: '/audience/audience-production.webp',
		imageAlt: 'Производственное предприятие',
	},
	{
		title: 'Оптовые компании',
		text: 'Нужны повторные продажи, учёт заказов, быстрый документооборот и прозрачность по клиентам.',
		image: '/audience/audience-wholesale.webp',
		imageAlt: 'Оптовая логистика и доставка',
	},
	{
		title: 'Сервисные компании',
		text: 'Важно управлять обращениями, статусами, сроками и качеством обслуживания.',
		image: '/audience/audience-service.webp',
		imageAlt: 'Сервисные работы и обслуживание',
	},
	{
		title: 'Строительство',
		text: 'Много этапов, согласований, подрядчиков и документов.',
		image: '/audience/audience-construction.webp',
		imageAlt: 'Строительный объект',
	},
	{
		title: 'Сложные внутренние процессы',
		text: 'Несколько департаментов, маршруты согласований и большая нагрузка на документооборот.',
		image: '/audience/audience-processes.webp',
		imageAlt: 'Связанные внутренние процессы',
	},
];
---

<section class="mx-auto max-w-[1440px] px-6 py-16 sm:py-24">
	<div class="mb-10 max-w-3xl">

		<h2 class="home-section-title">
			Компаниям, которым уже тесно в таблицах, чатах и ручных процессах
		</h2>
		<p class="home-section-copy">
			Если растут заявки, отделы, документы и внутренние процессы, пора собирать систему,
			а не латать хаос точечно.
		</p>
	</div>

	<div class="home-mobile-carousel home-card-grid grid gap-px overflow-hidden rounded-2xl border border-neutral-200 bg-neutral-200 sm:grid-cols-2 lg:grid-cols-3 dark:border-neutral-800 dark:bg-neutral-800">
		{segments.map((segment) => (
			<article class="home-swipe-card flex min-h-44 flex-col items-start gap-5 bg-white p-6 sm:flex-row dark:bg-neutral-950">
				<img
					src={segment.image}
					alt={segment.imageAlt}
					width="250"
					height="250"
					loading="lazy"
					decoding="async"
					class="mt-1 h-32 w-32 shrink-0 object-contain"
				/>
				<div>
					<h3 class="home-card-title">{segment.title}</h3>
					<p class="home-card-copy mt-3">{segment.text}</p>
				</div>
			</article>
		))}
	</div>
</section>
