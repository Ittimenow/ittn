---
import ServiceTimeline from './ServiceTimeline.astro';
import ServiceCta from './ServiceCta.astro';
import UiIcon from './UiIcon.astro';

const b24ButtonClass = 'consultation-trigger';

const painPoints = [
	{
		icon: 'briefcase',
		title: 'Нет своего IT-отдела',
		text: 'Сотрудникам некому передать правки по сайту, CRM и интеграциям, поэтому задачи копятся или решаются случайными исполнителями.',
	},
	{
		icon: 'shield',
		title: 'Сбой уже мешает бизнесу',
		text: 'Не отправляется форма, истёк сертификат, сайт работает медленно или данные перестали попадать в CRM.',
	},
	{
		icon: 'layers',
		title: 'Проект нужно развивать',
		text: 'Нужны новые страницы, сценарии, отчёты и автоматизация, но для отдельного проекта задача пока слишком небольшая.',
	},
] as const;

const serviceGroups = [
	{
		icon: 'cloud',
		title: 'Сайт и CMS',
		text: 'Поддерживаем корпоративные сайты, интернет-магазины, лендинги и веб-сервисы.',
		items: ['исправление ошибок', 'обновление CMS и модулей', 'формы, разделы и страницы', 'адаптивность и скорость'],
	},
	{
		icon: 'file',
		title: 'Контент и дизайн',
		text: 'Помогаем быстро обновлять информацию и сохранять единый визуальный стиль.',
		items: ['тексты, новости и товары', 'баннеры и изображения', 'верстка материалов', 'точечные UX/UI-правки'],
	},
	{
		icon: 'workflow',
		title: 'CRM, ERP и интеграции',
		text: 'Не ограничиваемся сайтом: находим проблему во всей цепочке движения заявки.',
		items: ['Bitrix24 и РосБизнесСофт', 'ELMA365', 'обмен с 1С', 'API, телефония и внешние сервисы'],
	},
	{
		icon: 'settings',
		title: 'Доработка функционала',
		text: 'Добавляем полезные функции без запуска большого проекта с нуля.',
		items: ['калькуляторы и квизы', 'личные кабинеты', 'поиск и фильтры', 'автоматические документы'],
	},
	{
		icon: 'lock',
		title: 'Инфраструктура',
		text: 'Помогаем держать техническую основу проекта в порядке.',
		items: ['SSL, домены и хостинг', 'резервные копии', 'восстановление после сбоя', 'настройка серверного окружения'],
	},
	{
		icon: 'bar-chart',
		title: 'Аудит и развитие',
		text: 'Ищем причины проблем и предлагаем улучшения в порядке бизнес-приоритета.',
		items: ['технический аудит', 'аналитика и цели', 'базовая SEO-проверка', 'план следующих доработок'],
	},
] as const;

const taskExamples = [
	{
		label: 'Контент',
		title: 'Обновить телефон, новость или изображение',
		text: 'Быстрая правка без поиска отдельного контент-менеджера и разработчика.',
		time: 'от 15 минут',
	},
	{
		label: 'Инцидент',
		title: 'Восстановить сайт после сбоя',
		text: 'Проверим причину, резервные копии и безопасный сценарий восстановления.',
		time: 'после диагностики',
	},
	{
		label: 'Развитие',
		title: 'Добавить услугу или новый раздел',
		text: 'Подготовим структуру, дизайн, верстку и подключение к административной панели.',
		time: 'оценим до старта',
	},
	{
		label: 'Скорость',
		title: 'Найти причину медленной загрузки',
		text: 'Проверим изображения, код, сервер, внешние скрипты и узкие места.',
		time: 'от 1 часа',
	},
	{
		label: 'Интеграция',
		title: 'Починить передачу заявки в CRM',
		text: 'Проследим путь данных от формы до сделки и устраним разрыв.',
		time: 'после диагностики',
	},
	{
		label: 'Безопасность',
		title: 'Установить или обновить SSL-сертификат',
		text: 'Настроим сертификат и проверим корректность переадресации.',
		time: 'от 30 минут',
	},
] as const;

const packages = [
	{
		name: 'Разово',
		tag: 'Начать с одной задачи',
		price: '3 500 ₽',
		unit: 'за час',
		rate: 'Без абонентской платы',
		text: 'Для срочной правки, диагностики или задачи, которую не хочется откладывать.',
		items: ['единая ставка любого специалиста', 'оценка до выполнения', 'ответ в течение 4 рабочих часов', 'типовые задачи — до 3 рабочих дней'],
		cta: 'Оценить задачу',
		featured: false,
	},
	{
		name: 'Минимум',
		tag: 'Редкие задачи',
		price: '26 000 ₽',
		unit: 'в месяц',
		rate: '10 часов · 2 600 ₽/час',
		text: 'Когда нужно регулярно обновлять информацию и решать небольшие технические вопросы.',
		items: ['до 10 обращений', 'техническая поддержка', 'информационная поддержка', 'консультация руководителя проекта'],
		cta: 'Выбрать минимум',
		featured: false,
	},
	{
		name: 'Норма',
		tag: 'Популярный',
		price: '50 000 ₽',
		unit: 'в месяц',
		rate: '20 часов · 2 500 ₽/час',
		text: 'Для бизнеса с постоянным потоком правок и задач по развитию сайта.',
		items: ['до 20 обращений', 'техническая поддержка', 'информационная поддержка', 'модернизация сайта'],
		cta: 'Выбрать норму',
		featured: true,
	},
	{
		name: 'Максимум',
		tag: 'Активное развитие',
		price: '72 000 ₽',
		unit: 'в месяц',
		rate: '30 часов · 2 400 ₽/час',
		text: 'Когда цифровые системы регулярно меняются вместе с продажами и процессами.',
		items: ['до 30 обращений', 'техническая поддержка', 'информационная поддержка', 'модернизация сайта'],
		cta: 'Выбрать максимум',
		featured: false,
	},
] as const;

const processSteps = [
	{
		title: 'Получаем задачу',
		text: 'Вы описываете проблему или желаемый результат. Если материалов не хватает, менеджер задаёт уточняющие вопросы.',
	},
	{
		title: 'Оцениваем до старта',
		text: 'Определяем состав работ, исполнителя, риски и трудоёмкость. Ничего не начинаем без согласования.',
	},
	{
		title: 'Выполняем и проверяем',
		text: 'Специалист решает задачу, а результат проходит проверку перед публикацией или передачей вам.',
	},
	{
		title: 'Фиксируем результат',
		text: 'Показываем, что сделано, сколько времени потрачено и что стоит сделать дальше.',
	},
] as const;

const roles = [
	['filter', 'Аналитик', 'Разбирается в задаче и переводит её с языка бизнеса на язык системы.'],
	['spark', 'UX/UI-дизайнер', 'Проектирует интерфейсы и готовит точечные визуальные изменения.'],
	['layers', 'Frontend-разработчик', 'Отвечает за интерфейс, адаптивность и работу страниц в браузере.'],
	['database', 'Backend-разработчик', 'Работает с логикой, данными, CMS, API и интеграциями.'],
	['bar-chart', 'SEO-специалист', 'Проверяет технические факторы, индексацию и аналитику.'],
	['file', 'Контент-менеджер', 'Размещает материалы, товары, новости и изображения.'],
] as const;

const principles = [
	['Один вход для всех задач', 'Не нужно самостоятельно искать разработчика, дизайнера или аналитика — состав команды подбираем мы.'],
	['Оценка до выполнения', 'Сначала согласуем трудоёмкость и ожидаемый результат, затем приступаем к работе.'],
	['Проверка перед публикацией', 'По возможности тестируем изменения отдельно и переносим их после проверки.'],
	['Понятный учёт времени', 'Фиксируем выполненные работы и потраченное время по каждой задаче.'],
] as const;

const faqs = [
	['Можно начать с одной задачи?', 'Да. Разовый формат стоит 3 500 ₽ за час и не требует абонентского договора. Опишите задачу — мы уточним детали и согласуем оценку до начала работ.'],
	['Вы поддерживаете проекты, которые делала другая команда?', 'Да. Сначала изучаем доступы, код, CMS, инфраструктуру и критичные интеграции. Если проект можно безопасно принять, формируем план первых работ.'],
	['Какие системы можно передать на поддержку?', 'Работаем с сайтами и веб-сервисами, CMS, Bitrix24, РосБизнесСофт, ELMA365, интеграциями с 1С, телефонией, почтой, платёжными и другими внешними сервисами. Возможность поддержки конкретного стека подтверждаем после знакомства с проектом.'],
	['Как учитывается время?', 'До старта согласуем оценку, после выполнения фиксируем фактические трудозатраты и результат. Условия минимального шага учёта и использования пакетных часов закрепляются в договоре.'],
	['Что делать, если задача оказалась больше оценки?', 'Останавливаемся на согласованной границе, объясняем причину и предлагаем обновлённую оценку. Продолжаем только после вашего подтверждения.'],
	['Работаете круглосуточно?', 'Базовые тарифы не включают круглосуточное дежурство. Для систем, где простой напрямую влияет на продажи или операции, отдельно оцениваем возможность регламента и SLA.'],
	['Чем поддержка отличается от отдельного проекта?', 'Поддержка подходит для небольших, повторяющихся и срочных задач. Если изменение требует большой аналитики, проектирования или нескольких недель разработки, предложим оформить его отдельным этапом с собственной сметой.'],
] as const;

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(([question, answer]) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: answer,
		},
	})),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<div class="ds support-landing">
	<section class="support-hero">
		<div class="support-container support-hero-grid">
			<div class="support-hero-copy">
				<nav class="service-breadcrumbs" aria-label="Хлебные крошки">
					<a href="/services/">Все услуги</a>
					<UiIcon name="chevron" class="h-[24.5px] w-[24.5px]" />
					<strong aria-current="page">Техническая поддержка</strong>
				</nav>
				<h1 transition:name="service-support">
					Решаем IT-задачи, пока вы занимаетесь <span>бизнесом</span>
				</h1>
				<p class="support-hero-lead">
					Поддерживаем сайты, CRM, ERP и интеграции: исправляем ошибки, обновляем
					контент и развиваем функционал без найма собственного IT-отдела.
				</p>
				<div class="support-hero-offer">
					<div>
						<strong>3 500 ₽</strong>
						<span>за час разовой работы</span>
					</div>
					<div>
						<strong>от 26 000 ₽</strong>
						<span>пакет на месяц</span>
					</div>
				</div>
				<div class="support-actions">
					<button class:list={['ds-btn ds-btn-primary', b24ButtonClass]} type="button" data-b24-form-trigger>
						<span>Оценить одну задачу</span>
						<UiIcon name="arrow" class="h-[28px] w-[28px]" />
					</button>
					<a class="support-text-link" href="#support-prices">Посмотреть тарифы</a>
				</div>
				<p class="support-hero-note">Уточним задачу и согласуем оценку до начала работ.</p>
			</div>

			<div class="support-console" aria-label="Как устроена работа технической поддержки">
				<div class="support-console-head">
					<div>
						<span class="support-status-dot"></span>
						<p>Поддержка проекта</p>
					</div>
					<span>единое окно</span>
				</div>
				<div class="support-ticket">
					<div class="support-ticket-top">
						<span>Новая задача</span>
						<span>01</span>
					</div>
					<h2>Форма на сайте не создаёт сделку в CRM</h2>
					<p>Проверяем всю цепочку: сайт → API → CRM</p>
				</div>
				<ol class="support-console-steps">
					<li class="is-done"><span>01</span><div><strong>Заявка принята</strong><small>Менеджер уточнил контекст</small></div><UiIcon name="check" class="h-[28px] w-[28px]" /></li>
					<li class="is-active"><span>02</span><div><strong>Оценка согласована</strong><small>Назначен нужный специалист</small></div><UiIcon name="settings" class="h-[28px] w-[28px]" /></li>
					<li><span>03</span><div><strong>Работа и проверка</strong><small>Результат фиксируем в отчёте</small></div><UiIcon name="shield" class="h-[28px] w-[28px]" /></li>
				</ol>
				<div class="support-console-foot">
					<span><UiIcon name="users" class="h-[28px] w-[28px]" /> Одна команда</span>
					<span><UiIcon name="bar-chart" class="h-[28px] w-[28px]" /> Прозрачный учёт</span>
				</div>
			</div>
		</div>
	</section>

	<section class="support-section support-section-soft">
		<div class="support-container">
			<div class="support-section-head">
				<div>
					<h2>IT-вопросы не должны отвлекать команду от клиентов</h2>
				</div>
				<p>Подключаемся, когда накопились небольшие задачи, произошёл сбой или текущий подрядчик перестал справляться.</p>
			</div>
			<div class="support-pain-grid support-mobile-row service-card-row">
				{painPoints.map((item) => (
					<article class="support-card support-pain-card">
						<div class="support-icon"><UiIcon name={item.icon} class="h-[35px] w-[35px]" /></div>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="support-section">
		<div class="support-container">
			<div class="support-section-head">
				<div>
					<h2>Одна команда вместо нескольких подрядчиков</h2>
				</div>
				<p>Берём на себя и простую контентную правку, и техническую задачу на стыке сайта, данных и внутренних систем.</p>
			</div>
			<div class="support-services-grid service-card-row">
				{serviceGroups.map((group) => (
					<article class="support-card support-service-card">
						<div class="support-icon"><UiIcon name={group.icon} class="h-[35px] w-[35px]" /></div>
						<h3>{group.title}</h3>
						<p>{group.text}</p>
						<ul class="ittn-marker-list">
							{group.items.map((item) => <li>{item}</li>)}
						</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="support-section support-section-ink">
		<div class="support-container">
			<div class="support-section-head support-section-head-light">
				<div>
					<h2>Можно прийти с небольшой задачей</h2>
				</div>
				<p>Время ниже — ориентир для понятных типовых работ. Точную оценку даём после проверки проекта и доступов.</p>
			</div>
			<div class="support-tasks-grid support-mobile-row service-card-row">
				{taskExamples.map((task) => (
					<article class="support-task-card">
						<div class="support-task-top"><span>{task.label}</span><span>{task.time}</span></div>
						<h3>{task.title}</h3>
						<p>{task.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="support-prices" class="support-section support-section-soft">
		<div class="support-container">
			<div class="support-section-head">
				<div>
					<h2>Начните разово или зарезервируйте команду</h2>
				</div>
				<p>Во всех форматах доступна рабочая группа специалистов. Чем больше пакет, тем ниже стоимость часа.</p>
			</div>
			<div class="support-prices-grid support-mobile-row service-card-row">
				{packages.map((pack) => (
					<article class:list={['support-price-card', pack.featured && 'is-featured']}>
						<div class="support-price-head">
							<h3>{pack.name}</h3>
							<span>{pack.tag}</span>
						</div>
						<div class="support-price-value"><strong>{pack.price}</strong><span>{pack.unit}</span></div>
						<p class="support-price-rate">{pack.rate}</p>
						<p class="support-price-text">{pack.text}</p>
						<ul class="ittn-marker-list">
							{pack.items.map((item) => <li>{item}</li>)}
						</ul>
						<button class:list={['ds-btn', pack.featured ? 'ds-btn-primary' : 'ds-btn-secondary', b24ButtonClass]} type="button" data-b24-form-trigger>
							<span>{pack.cta}</span>
							<UiIcon name="arrow" class="h-[28px] w-[28px]" />
						</button>
					</article>
				))}
			</div>
			<div class="support-price-note">
				<UiIcon name="message" class="h-[35px] w-[35px]" />
				<p><strong>Не знаете, сколько часов потребуется?</strong> Пришлите список задач — разложим их по приоритету и предложим подходящий формат.</p>
			</div>
		</div>
	</section>

	<ServiceTimeline title="Без чёрного ящика и внезапного счёта" text="У каждой задачи есть понятный путь: запрос, оценка, выполнение, проверка и зафиксированный результат." steps={processSteps} />

	<section class="support-section support-section-soft">
		<div class="support-container">
			<div class="support-section-head">
				<div>
					<h2>Под задачу подключается нужный специалист</h2>
				</div>
				<p>Вам не приходится координировать исполнителей: менеджер собирает рабочую группу и остаётся единым контактом.</p>
			</div>
			<div class="support-roles-grid support-mobile-row service-card-row">
				{roles.map(([icon, title, text]) => (
					<article class="support-role-card">
						<div class="support-icon"><UiIcon name={icon} class="h-[35px] w-[35px]" /></div>
						<h3>{title}</h3>
						<p>{text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="support-section">
		<div class="support-container">
			<div class="support-principles">
				<div class="support-principles-copy">
					<h2>Не просто часы, а управляемый сервис</h2>
					<p>Понятные правила снижают риск переделок, потерянных задач и зависимости от одного исполнителя.</p>
				</div>
				<div class="support-principles-list">
					{principles.map(([title, text], index) => (
						<article><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{text}</p></div></article>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="support-section support-section-soft">
		<div class="support-container support-faq-grid">
			<div>
				<h2>Частые вопросы о технической поддержке</h2>
				<p>Если вашего вопроса здесь нет, опишите ситуацию — на первой консультации подскажем возможный формат.</p>
			</div>
			<div class="support-faq-list">
