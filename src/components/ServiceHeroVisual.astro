---
import HeroParticles from './HeroParticles.astro';
import type { ServiceHeroSceneId } from '../data/service-hero-scenes';
interface Props { scene: ServiceHeroSceneId; }
const { scene } = Astro.props;
---
<div class="service-hero-visual">
  <HeroParticles scene={scene} showSettings={false} />
</div>
<style>
  .service-hero-visual { width:100%; max-width:620px; min-width:0; justify-self:center; align-self:center; }
  :global(.service-particle-hero.service-particle-hero) { background:#fff; }
  :global(.service-particle-hero.service-particle-hero::before),
  :global(.service-particle-hero.service-particle-hero::after) { display:none; }
  :global(.service-particle-grid.service-particle-grid) {
    display:grid; grid-template-columns:minmax(0, 1.15fr) minmax(0, 1fr);
    align-items:center; gap:clamp(24px, 4vw, 64px);
    padding-block:clamp(40px, 5vw, 72px); min-height:calc(100svh - 96px);
  }
  :global(.service-particle-grid > div) { min-width:0; }
  :global(section.service-particle-hero .service-particle-grid.service-particle-grid h1) { font-size:clamp(40px, 4.4vw, 68px); line-height:1.08; letter-spacing:-.03em; overflow-wrap:break-word; }
  :global(.service-particle-hero .service-particle-grid .service-hero-details) { grid-column:1 / -1; width:100%; max-width:none; margin:0; transform:none; }
  @media (max-width:1023px) {
    :global(.service-particle-grid.service-particle-grid) { grid-template-columns:minmax(0, 1fr); gap:24px; min-height:0; }
    .service-hero-visual { max-width:460px; }
  }
  @media (max-width:767px) {
    :global(.service-particle-grid.service-particle-grid) { padding-block:32px 40px; gap:20px; }
    :global(section.service-particle-hero .service-particle-grid.service-particle-grid h1) { font-size:clamp(34px, 8.8vw, 48px); }
    .service-hero-visual { max-width:360px; }
  }
</style>
