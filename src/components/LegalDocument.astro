---
import ServiceCta from './ServiceCta.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Layout from '../layouts/Layout.astro';

interface Props {
	title: string;
	description: string;
	date?: string;
}

const { title, description, date } = Astro.props;
---

<Layout title={`${title} — IT TIME NOW`} description={description}>
	<article class="mx-auto max-w-4xl px-6 py-16 sm:py-24">
		<Breadcrumbs current={title} />
		<h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl">{title}</h1>
		{date && <p class="mt-4 text-sm text-[color:var(--ds-muted)]">{date}</p>}
		<div class="legal-content mt-10">
			<slot />
		</div>
	</article>
<ServiceCta title="Есть вопросы об услугах и условиях работы?" text="На консультации уточним задачу, подходящий формат сотрудничества и порядок дальнейших действий." />
</Layout>

<style>
	.legal-content {
		color: var(--ds-muted);
		font-size: 1rem;
		line-height: 1.75;
	}

	.legal-content :global(h2) {
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		color: var(--ds-ink);
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.legal-content :global(p) {
		margin: 0.85rem 0;
	}

	.legal-content :global(a) {
		color: var(--ds-primary);
		text-decoration: underline;
		text-underline-offset: 0.2em;
		overflow-wrap: anywhere;
	}

	.legal-content :global(.document-date) {
		margin-top: 2.5rem;
		color: var(--ds-ink);
		font-weight: 700;
		text-align: right;
	}
</style>
