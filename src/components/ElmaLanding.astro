---
import ServiceCta from './ServiceCta.astro';
import UiIcon from './UiIcon.astro';

const painPoints = [
	{
		icon: 'message',
		title: 'Согласования живут в\u00A0почте и\u00A0чатах',
		text: 'Решения теряются в\u00A0переписке, а\u00A0сотрудники не\u00A0понимают, на\u00A0каком этапе документ.',
	},
	{
		icon: 'layers',
		title: 'Данные разбросаны по\u00A0системам',
		text: 'Клиентские, кадровые и\u00A0финансовые данные приходится переносить вручную.',
	},
	{
		icon: 'users',
		title: 'Процессы зависят от\u00A0конкретных людей',
		text: 'Отпуск или\u00A0увольнение сотрудника останавливает работу и\u00A0обнажает отсутствие регламентов.',
	},
	{
		icon: 'bar-chart',
		title: 'Руководителю не\u00A0видны узкие места',
		text: 'Невозможно быстро оценить сроки, загрузку команды и\u00A0причины задержек.',
	},
] as const;

const capabilities = [
	{
		icon: 'workflow',
		title: 'Управление процессами',
		text: 'Проектируем маршруты в\u00A0BPMN, назначаем роли, сроки, условия и\u00A0автоматические действия.',
		items: ['сквозные процессы', 'контроль SLA', 'эскалации и\u00A0уведомления'],
	},
	{
		icon: 'file',
		title: 'Документооборот',
		text: 'Организуем создание, согласование, подписание, хранение и\u00A0поиск документов.',
		items: ['договоры и\u00A0заявки', 'версии и\u00A0права', 'электронная подпись'],
	},
	{
		icon: 'briefcase',
		title: 'CRM и\u00A0работа с\u00A0клиентами',
		text: 'Связываем обращения, сделки, задачи, документы и\u00A0клиентские процессы в\u00A0одном контуре.',
		items: ['единая карточка', 'воронки продаж', 'омниканальные обращения'],
	},
	{
		icon: 'settings',
		title: 'Low-code приложения',
		text: 'Создаём внутренние приложения и\u00A0кабинеты быстрее классической разработки.',
		items: ['реестры и\u00A0формы', 'личные кабинеты', 'быстрые изменения'],
	},
	{
		icon: 'bar-chart',
		title: 'Аналитика и\u00A0контроль',
		text: 'Собираем показатели процессов на\u00A0дашбордах и\u00A0помогаем находить точки роста.',
		items: ['статусы в\u00A0реальном времени', 'KPI и\u00A0SLA', 'история исполнения'],
	},
	{
		icon: 'database',
		title: 'Интеграции и\u00A0данные',
		text: 'Встраиваем ELMA365 в\u00A0существующий IT-ландшафт без\u00A0дублирования информации.',
		items: ['1С и\u00A0корпоративные системы', 'REST API и\u00A0webhooks', 'AD и\u00A0единый вход'],
	},
] as const;

const steps = [
	{
		number: '1',
		title: 'Диагностика',
		text: 'Определяем цели, участников, узкие места и\u00A0метрики процесса.',
	},
	{
		number: '2',
		title: 'Проектирование',
		text: 'Описываем целевой процесс, роли, формы, данные и\u00A0интеграции.',
	},
	{
		number: '3',
		title: 'Настройка',
		text: 'Собираем решение в\u00A0ELMA365, подключаем системы и\u00A0переносим данные.',
	},
	{
		number: '4',
		title: 'Пилот и\u00A0обучение',
		text: 'Проверяем сценарии с\u00A0рабочей группой и\u00A0готовим пользователей.',
	},
	{
		number: '5',
		title: 'Запуск и\u00A0развитие',
		text: 'Выводим процесс в\u00A0промышленную эксплуатацию и\u00A0улучшаем по\u00A0метрикам.',
	},
] as const;

const processCircles = [
	'deco-circle-01.png',
	'deco-circle-02.png',
	'deco-circle-03.png',
	'deco-circle-04.png',
	'deco-circle-01.png',
] as const;

const processConnectors = [
	['deco-underline-02.png', 'rotate(-4deg)'],
	['deco-underline-01.png', 'rotate(3deg)'],
	['deco-underline-03.png', 'rotate(-3deg)'],
	['deco-underline-02.png', 'rotate(5deg) scaleX(-1)'],
] as const;

const integrations = [
	['1С', 'учёт и\u00A0финансы'],
	['Active Directory', 'пользователи и\u00A0SSO'],
	['Почта', 'письма и\u00A0уведомления'],
	['Телефония', 'звонки и\u00A0обращения'],
	['Сайт', 'формы и\u00A0личные кабинеты'],
	['API', 'любые внешние сервисы'],
] as const;

const results = [
	['Единый маршрут', 'Каждая задача, документ и\u00A0решение проходят по\u00A0понятному сценарию.'],
	['Прозрачные сроки', 'Статусы, ответственность и\u00A0просрочки видны без\u00A0ручных отчётов.'],
	['Быстрые изменения', 'Low-code позволяет развивать процессы вместе с\u00A0бизнесом.'],
	['Меньше рутины', 'Система сама создаёт задачи, заполняет документы и\u00A0отправляет уведомления.'],
] as const;

const faqs = [
	[
		'Какие процессы можно автоматизировать в\u00A0ELMA365?',
		'Практически любые повторяемые процессы: договоры, закупки, заявки, продажи, сервис, подбор сотрудников, командировки, бюджетирование и\u00A0внутренние согласования.',
	],
	[
		'Нужно ли\u00A0сразу автоматизировать всю компанию?',
		'Нет. Обычно начинаем с\u00A0одного приоритетного процесса, запускаем пилот и\u00A0масштабируем решение после проверки результата.',
	],
	[
		'Можно ли\u00A0связать ELMA365 с\u00A01С?',
		'Да. Настраиваем обмен справочниками, документами, статусами и\u00A0другими данными. Состав интеграции зависит от\u00A0конфигурации 1С и\u00A0целевого процесса.',
	],
	[
		'Сколько занимает внедрение?',
		'Срок зависит от\u00A0масштаба процесса, числа ролей, интеграций и\u00A0объёма миграции. После диагностики мы\u00A0предложим этапы, сроки и\u00A0границы первого запуска.',
	],
	[
		'Вы обучаете сотрудников?',
		'Да. Проводим обучение администраторов и\u00A0пользователей, готовим инструкции и\u00A0сопровождаем команду на\u00A0старте.',
	],
] as const;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(([question, answer]) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<div class="elma-landing">
	<section class="elma-hero">
		<div class="elma-container elma-hero-grid">
			<div class="elma-hero-copy">
				<nav class="service-breadcrumbs" aria-label="Хлебные крошки">
					<a href="/services/">Все услуги</a>
					<UiIcon name="chevron" class="h-[24.5px] w-[24.5px]" />
					<strong aria-current="page">ELMA365</strong>
				</nav>
				<h1 transition:name="service-elma">Внедрение <span>ELMA365</span> под&nbsp;процессы вашего бизнеса</h1>
				<p class="elma-lead">
					Переводим согласования, документы и&nbsp;сквозные процессы из&nbsp;почты и&nbsp;таблиц
					в&nbsp;единую цифровую среду. Проектируем, интегрируем, обучаем и&nbsp;помогаем развивать систему.
				</p>
				<div class="elma-actions">
					<button class="ds-btn ds-btn-primary consultation-trigger" type="button" data-b24-form-trigger>
						<span>Обсудить внедрение</span>
						<UiIcon name="arrow" class="h-[28px] w-[28px]" />
					</button>
					<a class="elma-text-link" href="#elma-capabilities">Посмотреть возможности <span>↓</span></a>
				</div>
				<ul class="elma-hero-points ittn-marker-list">
					{['BPMN-процессы', 'Электронный документооборот', 'Интеграция с\u00A01С'].map((item) => (
						<li>
							<span>{item}</span>
						</li>
					))}
				</ul>
			</div>

			<picture class="elma-hero-media">
				<img
					src="/main-elma.webp"
					alt="Бизнес-аналитик работает с цифровой схемой согласования в ELMA365"
					width="1086"
					height="1448"
					loading="eager"
					decoding="async"
				/>
			</picture>
		</div>
	</section>

	<section class="elma-section elma-section-soft">
		<div class="elma-container">
			<div class="elma-section-head">
				<div>
					<h2>Процессы растут быстрее, чем&nbsp;система управления</h2>
				</div>
				<p>ELMA365 помогает убрать разрывы между отделами и&nbsp;сделать работу предсказуемой.</p>
			</div>
			<div class="elma-pain-grid service-card-row">
				{painPoints.map(({ icon, title, text }, index) => (
					<article class="elma-card elma-pain-card">
						<span class="elma-card-index">0{index + 1}</span>
						<div class="elma-icon"><UiIcon name={icon} class="h-[35px] w-[35px]" /></div>
						<h3>{title}</h3>
						<p>{text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="elma-capabilities" class="elma-section">
		<div class="elma-container">
			<div class="elma-section-head">
				<div>
					<h2>Единая платформа для&nbsp;процессов, документов и&nbsp;данных</h2>
				</div>
				<p>Собираем решение вокруг задач бизнеса и&nbsp;оставляем команде понятную систему, которую можно развивать.</p>
			</div>
			<div class="elma-capability-grid service-card-row">
				{capabilities.map(({ icon, title, text, items }) => (
					<article class="elma-card elma-capability-card">
						<div class="elma-icon"><UiIcon name={icon} class="h-[35px] w-[35px]" /></div>
						<h3>{title}</h3>
						<p>{text}</p>
						<ul class="elma-capability-list">
							{items.map((item) => (
								<li><span></span>{item}</li>
							))}
						</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="elma-section elma-process-section">
		<div class="elma-container">
			<div class="elma-section-head">
				<div>
					<h2>От&nbsp;первой схемы до&nbsp;рабочего процесса</h2>
				</div>
				<p>Двигаемся короткими этапами: показываем результат, собираем обратную связь и&nbsp;снижаем риск большого запуска.</p>
			</div>
			<div class="elma-process-scroll" tabindex="0" aria-label="Прокручиваемый список этапов внедрения">
				<ol class="elma-process-track" aria-label="Этапы внедрения ELMA365">
					{steps.map(({ number, title, text }, index) => (
						<>
							<li class="elma-step">
								<div class="elma-step-circle">
									<img
										src={`/ds-v2/assets/decorations-split/${processCircles[index]}`}
										alt=""
										aria-hidden="true"
										loading="lazy"
										decoding="async"
									/>
									<div>
										<span>Этап</span>
										<img
											src={`/ds-v2/assets/decorations-split/deco-digit-${number}.png`}
											alt={number}
											loading="lazy"
											decoding="async"
										/>
									</div>
								</div>
								<h3>{title}</h3>
								<p>{text}</p>
							</li>
							{processConnectors[index] && (
								<li class="elma-step-connector" aria-hidden="true">
									<img
										src={`/ds-v2/assets/decorations-split/${processConnectors[index][0]}`}
										alt=""
										loading="lazy"
										decoding="async"
										style={`transform:${processConnectors[index][1]};`}
									/>
								</li>
							)}
						</>
					))}
				</ol>
			</div>
			<div class="elma-process-cta">
				<p>Не&nbsp;знаете, с&nbsp;какого процесса начать?</p>
				<button class="ds-btn ds-btn-dark consultation-trigger" type="button" data-b24-form-trigger>
					<span>Провести диагностику</span>
					<UiIcon name="arrow" class="h-[28px] w-[28px]" />
				</button>
			</div>
		</div>
	</section>

	<section class="elma-section">
		<div class="elma-container">
			<div class="elma-section-head">
				<div>
					<h2>Управляемая работа вместо ручного контроля</h2>
				</div>
				<p>Эффект фиксируем не&nbsp;по&nbsp;числу настроенных форм, а&nbsp;по&nbsp;изменениям в&nbsp;ежедневной работе команды.</p>
			</div>
			<div class="elma-results-grid service-card-row">
				{results.map(([title, text], index) => (
					<article class:list={['elma-result-card', index === 0 && 'is-featured']}>
						<UiIcon name={index === 0 ? 'workflow' : index === 1 ? 'bar-chart' : index === 2 ? 'rocket' : 'spark'} class="h-[42px] w-[42px]" />
						<h3>{title}</h3>
						<p>{text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="elma-section elma-section-soft">
		<div class="elma-container elma-integration-layout">
			<div class="elma-integration-copy">
				<h2>ELMA365 становится частью вашей IT-среды</h2>
				<p>Настраиваем безопасный обмен данными, чтобы сотрудники работали в&nbsp;едином процессе, а&nbsp;информация не&nbsp;дублировалась.</p>
				<div class="elma-security-note">
					<UiIcon name="shield" class="h-[42px] w-[42px]" />
					<div><strong>Роли и&nbsp;доступы</strong><span>Разделяем права на&nbsp;данные, документы и&nbsp;действия.</span></div>
				</div>
			</div>
			<div class="elma-integration-grid service-card-row">
				{integrations.map(([title, text]) => (
					<article class="elma-integration-card">
						<div class="elma-integration-dot"></div>
						<strong>{title}</strong>
						<span>{text}</span>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="elma-section elma-section-soft">
		<div class="elma-container elma-faq-layout">
			<div>
				<h2>Частые вопросы о&nbsp;внедрении ELMA365</h2>
				<p>Если вашего вопроса нет в&nbsp;списке, расскажите о&nbsp;процессе — ответим на&nbsp;консультации.</p>
			</div>
			<div class="elma-faq-list">
				{faqs.map(([question, answer]) => (
					<details class="elma-faq">
						<summary><span>{question}</span><span class="elma-faq-plus">+</span></summary>
						<div><p>{answer}</p></div>
					</details>
				))}
			</div>
		</div>
	</section>

	<ServiceCta title="Разберём ваш процесс и предложим первый шаг" text="На бесплатной встрече определим границы пилота, ключевые роли, интеграции и критерии успешного запуска. Без сложной технической подготовки, с понятным планом следующих действий." />
</div>

<style>
	.elma-landing {
		--elma-blue: var(--ittn-blue);
		--elma-ink: var(--ittn-ink);
		--elma-muted: var(--ittn-muted);
		--elma-border: var(--ittn-border);
		background: #fff;
		color: var(--elma-ink);
	}

	.elma-container { width: min(100% - 48px, 1180px); margin-inline: auto; }
	.elma-section { padding: 96px 0; }
	.elma-section-soft { border-block: 1px solid var(--elma-border); background: var(--ittn-cloud); }
	.elma-section-head { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(260px, .65fr); gap: 72px; align-items: end; margin-bottom: 48px; }
	.elma-section-head h2, .elma-integration-copy h2, .elma-faq-layout h2 { margin: 12px 0 0; max-width: 820px; font-size: clamp(34px, 4.4vw, 56px); line-height: 1.01; }
	.elma-section-head > p, .elma-integration-copy > p, .elma-faq-layout > div > p { margin: 0; color: var(--elma-muted); font-size: 18px; line-height: 1.6; }

	.elma-hero { position: relative; overflow: hidden; padding: 100px 0 92px; background: radial-gradient(circle at 82% 24%, rgba(35,43,255,.14), transparent 32%), linear-gradient(180deg, var(--ittn-cloud), #fff 78%); }
	.elma-hero::before { position: absolute; inset: 0; opacity: .22; pointer-events: none; content: ''; background-image: linear-gradient(rgba(35,43,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(35,43,255,.08) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, #000, transparent 82%); }
	.elma-hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(390px, .92fr); gap: 70px; align-items: center; }
	.elma-breadcrumbs { display: flex; align-items: center; gap: 7px; margin-bottom: 36px; color: var(--elma-muted); font-size: 13px; font-weight: 600; }
	.elma-breadcrumbs a { transition: color 160ms ease; }
	.elma-breadcrumbs a:hover { color: var(--elma-blue); }
	.elma-hero h1 { margin: 18px 0 24px; max-width: 760px; font-size: clamp(48px, 6vw, 78px); line-height: .94; letter-spacing: -.035em; }
	.elma-hero h1 span { position: relative; color: var(--elma-blue); white-space: nowrap; }
	.elma-lead { max-width: 690px; margin: 0; color: var(--elma-muted); font-size: 19px; line-height: 1.58; }
	.elma-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 32px; }
	.elma-text-link { color: var(--elma-blue); font-size: 14px; font-weight: 700; text-decoration: none; }
	.elma-text-link span { display: inline-block; margin-left: 4px; transition: transform 160ms ease; }
	.elma-text-link:hover span { transform: translateY(3px); }
	.elma-hero-points { display: flex; flex-wrap: wrap; gap: 12px 24px; margin: 34px 0 0; padding: 0; list-style: none; }
	.elma-hero-points li { display: flex; align-items: center; gap: 8px; color: #363b46; font-size: 13px; font-weight: 700; }

	.elma-hero-media { position: relative; display: block; overflow: hidden; border-radius: 28px; box-shadow: 0 34px 80px -38px rgba(35,43,255,.48); }
	.elma-hero-media::after { position: absolute; inset: 0; border: 1px solid rgba(35,43,255,.18); border-radius: inherit; box-shadow: inset 0 0 0 1px rgba(255,255,255,.18); pointer-events: none; content: ''; }
	.elma-hero-media img { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }

	.elma-pain-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
	.elma-card { position: relative; border: 1px solid var(--elma-border); border-radius: 24px; background: #fff; box-shadow: var(--ittn-shadow-soft); }
	.elma-pain-card { min-height: 286px; padding: 26px; transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease; }
	.elma-pain-card:hover, .elma-capability-card:hover { border-color: rgba(35,43,255,.3); box-shadow: var(--ds-glow); transform: translateY(-3px); }
	.elma-card-index { position: absolute; top: 22px; right: 24px; color: #b6bbca; font: 600 12px/1 var(--ittn-font-mono); }
	.elma-icon { display: grid; width: 46px; height: 46px; place-items: center; color: var(--elma-blue); }
	.elma-card h3 { margin: 24px 0 10px; font-size: 21px; line-height: 1.16; }
	.elma-card p { margin: 0; color: var(--elma-muted); font-size: 15px; line-height: 1.55; }

