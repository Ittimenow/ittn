---
import ServiceCta from './ServiceCta.astro';
import UiIcon from './UiIcon.astro';
import { aiServices } from '../data/ai-services';

const b24ButtonClass = 'consultation-trigger';

const painPoints = [
	{
		icon: 'message',
		title: 'Клиенты ждут ответа',
		text: 'Одни и те же вопросы приходят на сайт и в мессенджеры, а менеджеры отвечают только в рабочее время.',
		metric: 'Время до первого ответа',
	},
	{
		icon: 'file',
		title: 'Данные переносят вручную',
		text: 'Заявки, письма и документы приходится читать, классифицировать и заносить в CRM или 1С руками.',
		metric: 'Минуты на обработку заявки',
	},
	{
		icon: 'users',
		title: 'Знания зависят от людей',
		text: 'Регламенты лежат в разных папках, а за точным ответом сотрудники каждый раз идут к самому опытному коллеге.',
		metric: 'Время на поиск ответа',
	},
] as const;

const solutions = aiServices.map((service) => ({
	icon: service.icon,
	tag: service.eyebrow,
	title: service.cardTitle,
	text: service.heroLead,
	items: service.heroPoints,
	href: `/services/ai/${service.slug}/`,
}));

const scenarios = [
	{
		label: 'Продажи',
		icon: 'bar-chart',
		before: 'Менеджер читает обращение, ищет информацию и вручную создаёт сделку.',
		after: 'ИИ собирает контекст, готовит ответ и заполняет CRM. Менеджер проверяет и продолжает диалог.',
		metric: 'Скорость реакции и доля обработанных лидов',
	},
	{
		label: 'Поддержка',
		icon: 'message',
		before: 'Клиенты повторяют типовые вопросы, а качество ответа зависит от конкретного сотрудника.',
		after: 'Ассистент отвечает по базе знаний и передаёт нестандартный случай оператору вместе с историей.',
		metric: 'Время ответа и доля передач оператору',
	},
	{
		label: 'Операции',
		icon: 'settings',
		before: 'Сотрудники переносят данные из писем и документов между несколькими системами.',
		after: 'Сценарий извлекает данные, проверяет правила и создаёт запись или задачу после контроля.',
		metric: 'Время обработки и число исправлений',
	},
] as const;

const integrations = [
	['cloud', 'Сайт и интернет-магазин'],
	['message', 'Telegram и мессенджеры'],
	['briefcase', 'Bitrix24 и другие CRM'],
	['database', '1С, ERP и базы данных'],
	['file', 'Почта и документы'],
	['workflow', 'API и внутренние сервисы'],
] as const;

const processSteps = [
	{
		title: 'Разбираем один процесс',
		text: 'Выбираем повторяющуюся задачу, фиксируем текущий сценарий, ограничения и метрику результата.',
	},
	{
		title: 'Проверяем на ваших данных',
		text: 'Собираем ограниченный прототип и проверяем качество ответов или действий на реальных примерах.',
	},
	{
		title: 'Запускаем пилот',
		text: 'Подключаем один рабочий канал, задаём границы самостоятельности и измеряем согласованный показатель.',
	},
	{
		title: 'Интегрируем и развиваем',
		text: 'Встраиваем решение в CRM, 1С или сайт, настраиваем мониторинг и добавляем новые сценарии по эффекту.',
	},
] as const;

const controls = [
	{
		icon: 'shield',
		title: 'Ограничиваем полномочия',
		text: 'Определяем, что ИИ делает сам, что только предлагает и когда обязан передать задачу сотруднику.',
	},
	{
		icon: 'database',
		title: 'Опираемся на ваши данные',
		text: 'Подключаем согласованные документы и справочники, показываем источники и учитываем права доступа.',
	},
	{
		icon: 'check',
		title: 'Проверяем качество',
		text: 'Готовим тестовые примеры, журналируем действия и согласуем допустимый уровень ошибок до запуска.',
	},
	{
		icon: 'lock',
		title: 'Проектируем безопасный контур',
		text: 'Выбираем облачную или локальную схему с учётом состава данных и требований вашего бизнеса.',
	},
] as const;

const faqs = [
	['С какой задачи лучше начать?', 'С частой и понятной задачи, где можно сравнить состояние до и после: время ответа, длительность обработки, число ручных действий или долю обращений, переданных сотруднику. На первой встрече поможем выбрать подходящий сценарий.'],
	['Нужно ли менять CRM или другие системы?', 'Обычно нет. Мы проектируем ИИ как дополнительный слой и подключаем его к существующему сайту, CRM, 1С, почте или мессенджерам через доступные API и интеграционные механизмы.'],
	['Может ли ИИ ошибаться?', 'Да, поэтому мы не обещаем абсолютную точность. Ограничиваем источники и полномочия, проверяем сценарий на реальных примерах, показываем ссылки на документы и передаём спорные случаи человеку.'],
	['Какие данные понадобятся для пилота?', 'Небольшой набор обезличенных или согласованных примеров: обращения, документы, ответы, регламенты или карточки процесса. Точный состав и способ передачи определяем после знакомства с задачей.'],
	['Можно использовать российские модели?', 'Да. В зависимости от задачи рассматриваем российские и зарубежные модели, облачное API или локальное размещение. Выбор зависит от качества, стоимости, скорости и требований к данным.'],
	['Сколько стоит внедрение?', 'Стоимость зависит от числа каналов, интеграций, объёма данных и требований к размещению. Сначала определяем ограниченный состав пилота, после чего фиксируем результат, сроки и стоимость до начала разработки.'],
	['ИИ заменит сотрудников?', 'Мы проектируем решение как инструмент команды: ИИ берёт повторяющиеся операции, а сотрудники контролируют качество, решают нестандартные случаи и общаются там, где важны опыт и ответственность.'],
] as const;

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(([question, answer]) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: answer,
		},
	})),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<div class="ds ai-landing">
	<section class="ai-hero">
		<div class="ai-container ai-hero-grid">
			<div class="ai-hero-copy">
				<nav class="service-breadcrumbs" aria-label="Хлебные крошки">
					<a href="/services/">Все услуги</a>
					<UiIcon name="chevron" class="h-[24.5px] w-[24.5px]" />
					<strong aria-current="page">ИИ для бизнеса</strong>
				</nav>
				<h1 transition:name="service-ai">ИИ для бизнеса: <span>от идеи до рабочего процесса</span></h1>
				<p class="ai-hero-lead">
					Создаём ИИ-консультантов, ассистентов продаж и базы знаний, автоматизируем обработку
					документов и связываем решение с сайтом, CRM, ERP, 1С и мессенджерами.
				</p>
				<div class="bitrix-actions">
					<button class:list={['ds-btn ds-btn-primary', b24ButtonClass]} type="button" data-b24-form-trigger>
						<span>Получить консультацию</span>
						<UiIcon name="arrow" class="h-[28px] w-[28px]" />
					</button>
					<p class="bitrix-free-label">Бесплатно!</p>
				</div>
			</div>

			<picture class="ai-hero-media">
				<img
					src="/services/ai/ai-hero-3d.webp"
					alt="Объёмный символ AI, объединяющий данные и бизнес-системы"
					width="1086"
					height="1448"
					loading="eager"
					decoding="async"
				/>
			</picture>
		</div>
	</section>

	<section class="ai-section">
		<div class="ai-container">
			<div class="ai-section-head">
				<div>
					<h2>Когда ИИ полезен</h2>
				</div>
				<p>Разбираем, как сотрудники отвечают клиентам, обрабатывают заявки и ищут информацию. Затем подключаем ИИ к нужным данным и системам, чтобы сократить время ответа, ускорить обработку и упростить поиск знаний.</p>
			</div>
			<div class="ai-pain-grid ai-card-row service-card-row">
				{painPoints.map((item) => (
					<article class="ai-card ai-pain-card">
						<div class="ai-icon"><UiIcon name={item.icon} class="h-[35px] w-[35px]" /></div>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
						<div class="ai-metric"><span>Что измеряем</span><strong>{item.metric}</strong></div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="ai-solutions" class="ai-section">
		<div class="ai-container">
			<div class="ai-section-head">
				<div>
					<h2>Четыре направления прикладного ИИ</h2>
				</div>
				<p>Выберите задачу, с которой хотите начать. Каждое направление ведёт на отдельную страницу с возможностями, процессом запуска и критериями пилота.</p>
			</div>
			<div class="ai-solutions-grid ai-card-row service-card-row">
				{solutions.map((item, index) => (
					<a href={item.href} class:list={['ai-card ai-solution-card', index === 0 && 'is-featured']}>
						<div class="ai-solution-top">
							<div class="ai-icon"><UiIcon name={item.icon} class="h-[35px] w-[35px]" /></div>
							<span>{String(index + 1).padStart(2, '0')}</span>
						</div>
						<p class="ai-card-tag">{item.tag}</p>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
						<ul class="ittn-marker-list">
							{item.items.map((feature) => <li>{feature}</li>)}
						</ul>
						<span class="ai-solution-link">Подробнее <UiIcon name="arrow" class="h-[28px] w-[28px]" /></span>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="ai-section ai-section-ink">
		<div class="ai-container">
			<div class="ai-section-head ai-section-head-light">
				<div>
					<h2>ИИ выполняет рутину, сотрудник принимает решение</h2>
				</div>
				<p>Для каждого сценария заранее определяем границу автоматизации и показатель, по которому оценим пользу.</p>
			</div>
			<div class="ai-scenarios ai-card-row service-card-row">
				{scenarios.map((scenario) => (
					<article class="ai-scenario-card">
						<div class="ai-scenario-label"><UiIcon name={scenario.icon} class="h-[35px] w-[35px]" /><strong>{scenario.label}</strong></div>
						<div><span>Сейчас</span><p>{scenario.before}</p></div>
						<div class="ai-scenario-arrow"><img src="/ds-v2/assets/decorations-split/deco-arrow-04.png" alt="" aria-hidden="true" /></div>
						<div><span>После пилота</span><p>{scenario.after}</p></div>
						<div class="ai-scenario-metric"><span>Метрика</span><strong>{scenario.metric}</strong></div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="ai-section ai-integration-section">
		<div class="ai-container ai-integration-layout">
			<div class="ai-integration-copy">
				<h2>ИИ становится частью вашей экосистемы</h2>
				<p>Подключаем его к источнику обращения, корпоративным знаниям и системе, где команда уже ведёт работу.</p>
				<ul class="ittn-marker-list">
					<li>данные не приходится переносить вручную</li>
					<li>действия и результат остаются в рабочей системе</li>
					<li>сотрудник видит контекст и может вмешаться</li>
				</ul>
			</div>
			<div class="ai-integration-map" aria-label="Схема интеграций ИИ с системами бизнеса">
				<div class="ai-integration-orbit">
					<svg class="ai-orbit-lines" viewBox="0 0 600 600" aria-hidden="true">
						<line x1="300" y1="300" x2="300" y2="58" />
						<line x1="300" y1="300" x2="510" y2="178" />
						<line x1="300" y1="300" x2="510" y2="422" />
						<line x1="300" y1="300" x2="300" y2="542" />
						<line x1="300" y1="300" x2="90" y2="422" />
						<line x1="300" y1="300" x2="90" y2="178" />
					</svg>
					<div class="ai-core">
						<UiIcon name="spark" class="ai-core-icon" />
						<strong>ИИ-сценарий</strong>
					</div>
					{integrations.map(([icon, title], index) => (
						<div class={`ai-integration-node is-${index + 1}`}>
							<div><UiIcon name={icon} class="h-[35px] w-[35px]" /></div>
							<span>{title}</span>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<section id="ai-pilot" class="ai-section">
		<div class="ai-container">
			<div class="ai-section-head">
				<div>
					<h2>Сначала проверяем гипотезу, потом расширяем</h2>
				</div>
				<p>Состав, срок и стоимость каждого этапа согласуем до начала работ. Пилот не требует перестраивать весь IT-контур компании.</p>
			</div>
			<ol class="ai-process" aria-label="Этапы запуска ИИ-сценария">
				{processSteps.map((step, index) => (
					<li class="ai-process-card">
						<div class="ai-process-number" aria-hidden="true">
							<img class="ai-process-circle" src={`/ds-v2/assets/decorations-split/deco-circle-0${index + 1}.png`} alt="" />
							<span>Этап</span>
							<img class="ai-process-digit" src={`/ds-v2/assets/decorations-split/deco-digit-${index + 1}.png`} alt="" />
						</div>
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</li>
				))}
			</ol>
			<div class="ai-pilot-callout">
				<div>
					<h3>Повторяется часто, имеет понятные правила и достаточно примеров</h3>
				</div>
				<p>Принесите процесс, на который команда регулярно тратит время. Мы поможем сузить его до проверяемого сценария и предложим метрику.</p>
				<button class:list={['ds-btn ds-btn-primary', b24ButtonClass]} type="button" data-b24-form-trigger>
					<span>Обсудить пилот</span>
					<UiIcon name="arrow" class="h-[28px] w-[28px]" />
				</button>
			</div>
		</div>
	</section>

	<section class="ai-section">
		<div class="ai-container">
			<div class="ai-section-head">
				<div>
					<h2>Безопасность и проектируемый контроль</h2>
				</div>
				<p>ИИ может ошибаться. Поэтому точность, безопасность и участие человека закладываем в сценарий до рабочего запуска.</p>
			</div>
			<div class="ai-controls-grid ai-card-row service-card-row">
				{controls.map((item) => (
					<article class="ai-card ai-control-card">
						<div class="ai-icon"><UiIcon name={item.icon} class="h-[35px] w-[35px]" /></div>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="ai-section">
		<div class="ai-container ai-faq-grid">
			<div>
				<h2>Частые вопросы о внедрении ИИ</h2>
				<p>Если вы пока не знаете, какое решение нужно, начнём с процесса и текущей проблемы — технологии предложим после разбора.</p>
			</div>
			<div class="ai-faq-list">
				{faqs.map(([question, answer]) => (
					<details class="ai-faq">
						<summary><span>{question}</span><UiIcon name="chevron" class="h-[28px] w-[28px]" /></summary>
						<div><p>{answer}</p></div>
					</details>
				))}
			</div>
		</div>
	</section>

	<ServiceCta title="Обсудим, где ИИ принесёт пользу вашему бизнесу?" text="Для первой встречи не нужны техническое задание и выбранная технология. Опишите процесс, который отнимает время, а мы предложим сценарий, формат пилота и следующий шаг." />

</div>

<style>
	:global(body.ai-page) { background: #fff; }

	.ai-landing {
		--ai-ink: var(--ds-ink);
		--ai-blue: var(--ds-primary);
		--ai-soft: var(--ds-soft);
		--ai-line: var(--ds-border);
		background: #fff;
		color: var(--ai-ink);
	}

	.ai-container { width: min(100% - 48px, 1440px); margin-inline: auto; }
	.ai-section { padding-block: 24px; }
	.ai-section-ink { overflow: hidden; background: var(--ds-ink); color: var(--ds-bg); }
	.ai-section-head { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr); align-items: end; gap: clamp(32px, 7vw, 112px); margin-bottom: 48px; }
	.ai-section-head h2, .ai-integration-copy h2, .ai-faq-grid h2 { max-width: 900px; margin: 0; font-size: clamp(34px, 4.45vw, 64px); font-weight: 700; line-height: .98; letter-spacing: -.045em; }
	.ai-section-head > p, .ai-integration-copy > p, .ai-faq-grid > div > p { margin: 0; color: var(--ds-muted); font-size: 17px; line-height: 1.65; }
	.ai-section-head-light h2 { color: var(--ds-bg); }
	.ai-section-head-light > p { color: var(--ds-tertiary); }

	.ai-hero { overflow: hidden; border-bottom: 1px solid var(--ai-line); background: #fff !important; }
	.ai-hero::before, .ai-hero::after { display: none !important; content: none !important; }
	.ai-hero-grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(340px, .72fr); align-items: center; gap: clamp(52px, 7vw, 118px); padding-block: 24px 46px; }
	.ai-breadcrumbs { display: flex; align-items: center; gap: 8px; margin-bottom: 24px; color: #707684; font-size: 13px; }
	.ai-breadcrumbs a { color: inherit; transition: color 160ms ease; }
	.ai-breadcrumbs a:hover { color: var(--ai-blue); }
	.ai-hero-copy h1 { max-width: 850px; margin: 0; font-size: clamp(46px, 5.6vw, 82px); font-weight: 700; line-height: .92; letter-spacing: -.06em; }
	.ai-hero-copy h1 span { color: var(--ai-blue); }
	.ai-hero-lead { max-width: 740px; margin: 28px 0 0; color: #4f5562; font-size: clamp(18px, 1.5vw, 22px); line-height: 1.55; }
	.bitrix-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 32px; }
	.bitrix-free-label { position: relative; display: inline-flex; align-items: center; justify-content: center; margin: 0; padding: 9px 18px; color: var(--ittn-blue); font-family: var(--ittn-font-mono); font-size: 12px; font-weight: 600; line-height: 1.35; text-transform: uppercase; letter-spacing: .1em; }
	.bitrix-free-label::before { position: absolute; inset: 0; background: url('/ds-v2/assets/decorations-split/deco-ellipse-large.png') center / 100% 100% no-repeat; content: ''; pointer-events: none; }
	.ai-hero-media { display: block; width: min(100%, 470px); align-self: center; justify-self: end; padding: 20px; }
	.ai-hero-media img { display: block; width: 100%; height: auto; max-height: 680px; object-fit: contain; filter: drop-shadow(0 30px 42px rgba(17,17,17,.12)); }

	.ai-card { border: 1px solid var(--ai-line); border-radius: 24px; background: #fff; }
	.ai-icon { display: grid; width: 42px; height: 42px; place-items: center; color: var(--ai-blue); }
	.ai-pain-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
	.ai-pain-card { display: flex; min-height: 300px; flex-direction: column; padding: 28px; }
	.ai-pain-card h3, .ai-control-card h3 { margin: 24px 0 0; font-size: 23px; line-height: 1.12; }
