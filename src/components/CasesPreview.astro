---
import { getCollection } from 'astro:content';

const all = await getCollection('cases');
const cases = all
	.filter((c) => c.data.featured)
	.sort((a, b) => b.data.order - a.data.order)
	.slice(0, 5);
---

<section class="mx-auto max-w-[1440px] px-6 py-16 sm:py-24">
	<div class="mb-10 flex items-end justify-between gap-6">
		<div>

			<h2 class="home-section-title">
				Кейсы: как это работает в реальном бизнесе
			</h2>
			<p class="home-section-copy">
				Показываем не просто проекты, а задачи, решения и результат.
			</p>
		</div>
		<a
			href="/cases/"
			class="hidden text-sm font-medium text-indigo-600 hover:text-indigo-700 sm:inline dark:text-indigo-400"
		>
			Все кейсы →
		</a>
	</div>

	<div class="home-mobile-carousel grid gap-4 md:grid-cols-2 lg:grid-cols-3">
		{cases.map((c, i) => (
			<a
				href={`/cases/${c.id}/`}
				class:list={[
					'home-link-card group flex min-h-80 flex-col p-6',
					i === 0 && 'lg:col-span-2',
				]}
				transition:name={`case-${c.id}`}
			>
				<div class="mb-3 flex items-center gap-2 text-xs text-neutral-500">
					<span class="font-medium">{c.data.client}</span>
					{c.data.industry && <><span>·</span><span>{c.data.industry}</span></>}
					{c.data.year && <><span>·</span><span>{c.data.year}</span></>}
				</div>
				<h3 class="home-card-title">{c.data.title}</h3>
				<p class="home-card-copy mt-3">{c.data.summary}</p>
				{c.data.stack.length > 0 && (
					<div class="mt-auto pt-6 flex flex-wrap gap-1.5">
						{c.data.stack.slice(0, 4).map((s) => (
							<span class="rounded-full border border-neutral-200 bg-[var(--ittn-cloud)] px-2 py-0.5 text-xs text-neutral-600 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-400">
								{s}
							</span>
						))}
					</div>
				)}
			</a>
		))}
	</div>

	<div class="mt-6 sm:hidden">
		<a href="/cases/" class="text-sm font-medium text-indigo-600 dark:text-indigo-400">Все кейсы →</a>
	</div>
</section>
