---
const outcomes = [
	'Прозрачная воронка продаж',
	'Меньше ручной работы',
	'Быстрее обработка заявок',
	'Связанные между собой отделы и данные',
	'Управляемые процессы вместо хаоса',
	'Система, которую можно развивать и масштабировать',
];
---

<section class="bg-[var(--ittn-cloud)] py-16 sm:py-24">
	<div class="mx-auto grid max-w-[1440px] gap-10 px-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-start">
		<div>

			<h2 class="home-section-title">
				Что получает бизнес на выходе
			</h2>
			<p class="home-section-copy">
				Итогом становится не набор настроек, а управляемая система: понятная команде,
				связанная с текущими процессами и готовая к развитию.
			</p>
		</div>

		<ul class="home-mobile-carousel home-card-grid grid gap-px overflow-hidden rounded-2xl border border-neutral-200 bg-neutral-200 sm:grid-cols-2 dark:border-neutral-800 dark:bg-neutral-800">
			{outcomes.map((outcome) => (
				<li class="home-swipe-card flex min-h-28 items-start gap-4 bg-white p-5 text-xl font-semibold leading-[1.2] text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
					<img
						src="/ds-v2/assets/decorations-split/deco-check-04.png"
						alt=""
						loading="lazy"
						decoding="async"
						class="mt-0.5 h-7 w-7 shrink-0 object-contain"
					/>
					{outcome}
				</li>
			))}
		</ul>
	</div>
</section>
