---
import UiIcon from './UiIcon.astro';
---

<button class="web-sticky-cta consultation-trigger" type="button" data-b24-form-trigger>
	<span class="web-sticky-label">Бесплатная консультация</span>
	<span class="web-sticky-icon">
		<UiIcon name="phone" class="h-[35px] w-[35px]" />
	</span>
</button>

<style>
	.web-sticky-cta {
		position: fixed;
		right: 18px;
		bottom: 18px;
		z-index: 60;
		display: inline-flex;
		overflow: hidden;
		width: 56px;
		min-height: 56px;
		align-items: center;
		justify-content: flex-end;
		gap: 10px;
		border: 0;
		border-radius: 9999px;
		background: #232bff;
		color: #fff;
		padding: 0 10.5px;
		font-size: 14px;
		font-weight: 700;
		line-height: 1;
		white-space: nowrap;
		box-shadow: 0 18px 44px -18px rgba(35, 43, 255, 0.9);
		cursor: pointer;
		transition: width 260ms ease, padding 260ms ease, background 180ms ease, box-shadow 180ms ease, transform 180ms ease;
	}

	.web-sticky-cta:hover,
	.web-sticky-cta:focus-visible {
		width: 280px;
		background: #181ee6;
		padding-left: 34px;
		box-shadow: 0 22px 54px -20px rgba(35, 43, 255, 0.95);
		transform: translateY(-1px);
	}

	.web-sticky-icon {
		display: inline-grid;
		width: 35px;
		height: 35px;
		flex: 0 0 35px;
		place-items: center;
		animation: web-phone-ring 4.8s ease-in-out infinite;
		transform-origin: 50% 50%;
	}

	.web-sticky-label {
		opacity: 0;
		transform: translateX(8px);
		transition: opacity 160ms ease 80ms, transform 180ms ease 80ms;
	}

	.web-sticky-cta:hover .web-sticky-label,
	.web-sticky-cta:focus-visible .web-sticky-label {
		opacity: 1;
		transform: translateX(0);
	}

	@keyframes web-phone-ring {
		0%,
		74%,
		100% {
			transform: rotate(0deg);
		}

		77% {
			transform: rotate(-16deg);
		}

		80% {
			transform: rotate(14deg);
		}

		83% {
			transform: rotate(-12deg);
		}

		86% {
			transform: rotate(10deg);
		}

		89% {
			transform: rotate(-6deg);
		}

		92% {
			transform: rotate(0deg);
		}
	}

	@media (max-width: 640px) {
		.web-sticky-cta {
			right: 12px;
			bottom: 12px;
		}

		.web-sticky-cta:hover,
		.web-sticky-cta:focus-visible {
			width: min(280px, calc(100vw - 24px));
		}
	}
</style>
