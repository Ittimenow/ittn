---
import type { ComponentProps } from 'astro/types';
import DevelopmentServicePage from './DevelopmentServicePage.astro';

const problems: ComponentProps<typeof DevelopmentServicePage>['problems'] = [
	{ icon: 'file', title: 'Данные переносят вручную', text: 'Сотрудники копируют контакты, заказы, счета, оплаты и статусы между сайтом, CRM, 1С и таблицами.' },
	{ icon: 'database', title: 'Информация расходится', text: 'В разных системах отличаются цены, остатки, реквизиты и статусы. Непонятно, какой источник считать актуальным.' },
	{ icon: 'filter', title: 'Заявки теряются между системами', text: 'Форма отправила письмо, но сделка не появилась в CRM, не получила ответственного или остановилась на следующем этапе.' },
	{ icon: 'shield', title: 'Обмен работает без контроля', text: 'Ошибки обнаруживаются только после обращения клиента или при ручной сверке данных.' },
];

const offerings: ComponentProps<typeof DevelopmentServicePage>['offerings'] = [
	{ icon: 'message', title: 'Сайт и CRM', text: 'Передаём заявки, контакты, товары, источники обращения и выбранные параметры. Создаём сделку, назначаем ответственного и запускаем согласованные действия.' },
	{ icon: 'database', title: 'CRM, ERP и 1С', text: 'Синхронизируем клиентов, товары, счета, заказы, оплаты, остатки и статусы в пределах согласованной модели данных.' },
	{ icon: 'bar-chart', title: 'Оплата и финансы', text: 'Подключаем эквайринг, онлайн-кассы, банки и сервисы выставления счетов.' },
	{ icon: 'phone', title: 'Телефония и коммуникации', text: 'Связываем звонки, электронную почту, мессенджеры, SMS и сервисы рассылок с клиентами и сделками.' },
	{ icon: 'layers', title: 'Товары, склад и доставка', text: 'Настраиваем обмен каталогом, ценами, остатками, заказами и статусами доставки.' },
	{ icon: 'workflow', title: 'Внешние API и внутренние системы', text: 'Разрабатываем интеграционный слой для отраслевых, партнёрских и самописных систем.', featured: true },
];

const values: ComponentProps<typeof DevelopmentServicePage>['values'] = [
	{ icon: 'filter', title: 'Разбор и карта обмена', text: 'Определяем системы, владельцев данных, события, направления обмена, ограничения и критичные ошибки.' },
	{ icon: 'arrow', title: 'Одна интеграция', text: 'Решаем конкретную задачу между двумя системами: например, сайт → CRM или интернет-магазин ↔ 1С.' },
	{ icon: 'workflow', title: 'Интеграционный контур', text: 'Связываем несколько систем в единый процесс и определяем, где создаются и обновляются ключевые данные.' },
	{ icon: 'settings', title: 'API для продукта', text: 'Проектируем интерфейс, через который к продукту подключаются партнёры, приложения и внутренние системы.' },
	{ icon: 'shield', title: 'Обработка ошибок', text: 'Заранее определяем поведение при недоступности системы, дублях, конфликте или неполных данных.' },
	{ icon: 'bar-chart', title: 'Контроль после запуска', text: 'Согласовываем журналирование, уведомления, мониторинг и формат последующей поддержки.' },
];

const cases = [
	{
		title: 'Сокращение времени обработки заявки в 3 раза',
		href: '/cases/perola-crm/',
		image: '/cases/perola-crm/main-image-perolasky.webp',
		text: 'Связали сайт, административную панель, CRM-сценарии и уведомления для сервиса частных перелётов.',
		result: 'Обработка заявки стала в 3 раза быстрее',
	},
	{
		title: 'CRM/ERP и интерфейс сервисных специалистов',
		href: '/cases/home-assist-service-crm/',
		image: '/cases/home-assist/main-homeassit.webp',
		text: 'Объединили рабочие сценарии, платежи, мессенджеры и интерфейс распределённой сети исполнителей.',
		result: 'Скорость обработки заявки увеличена на 70%',
	},
	{
		title: 'Интеграция amoCRM и РосБизнесСофт',
		href: '/cases/alfacase-amocrm-rbs/',
		image: '/cases/alfacase-amocrm-rbs/img-alfacases-1.webp',
		text: 'Объединили продажи, производство и финансы производителя защитных кейсов в едином процессе.',
		result: 'Данные сделки автоматически передаются в ERP',
	},
];

const process = [
	{ title: 'Разбираем процесс', text: 'Фиксируем текущую цепочку, участников, ручные операции и ожидаемый бизнес-результат.', result: 'Понятные границы интеграции.' },
	{ title: 'Проверяем системы', text: 'Изучаем документацию, доступные API, права, лимиты, форматы данных и ограничения.', result: 'Подтверждённый технический сценарий.' },
	{ title: 'Проектируем обмен', text: 'Определяем источники данных, события, направления, правила обновления и ответственность систем.', result: 'Карта обмена и критерии готовности.' },
	{ title: 'Разрабатываем', text: 'Создаём интеграционный слой, авторизацию, преобразование данных и обработку согласованных ошибок.', result: 'Рабочий обмен на тестовом контуре.' },
	{ title: 'Тестируем', text: 'Проверяем штатные операции, дубли, неполные данные, недоступность систем и повторную обработку.', result: 'Протокол приёмочного тестирования.' },
	{ title: 'Запускаем поэтапно', text: 'Переводим обмен в рабочий контур и контролируем первые реальные операции.', result: 'Стабильная работа интеграции.' },
	{ title: 'Поддерживаем', text: 'Передаём документацию, реагируем на ошибки и адаптируем обмен к изменениям систем.', result: 'Управляемое развитие интеграционного контура.' },
];

const reasons = [
	{ title: 'Обследование и карта данных', text: 'Определяем системы, события, поля, владельцев данных и частоту обмена до начала разработки.' },
	{ title: 'Правила создания и обновления', text: 'Фиксируем, как появляются записи, что можно менять и как обрабатываются дубли и конфликты.' },
	{ title: 'Безопасность и права', text: 'Используем доступные механизмы авторизации и передаём только согласованный состав данных.' },
	{ title: 'Тестовый контур и приёмка', text: 'Проверяем сценарии на контролируемых данных до включения рабочего обмена.' },
	{ title: 'Документация и поддержка', text: 'Описываем логику интеграции и согласовываем мониторинг, реакцию на ошибки и дальнейшие изменения.' },
];

const faqs: [string, string][] = [
	['Можно интегрировать любые системы?', 'Возможность зависит от доступных API, выгрузок, прав доступа и ограничений конкретных продуктов. Это проверяется до оценки разработки.'],
	['Что делать, если у системы нет API?', 'Изучаем другие безопасные способы обмена: файлы, webhooks, доступные модули, промежуточную базу или доработку на стороне системы. Подход выбирается после технического обследования.'],
	['Как определяется стоимость?', 'На неё влияют количество систем, объём и частота данных, двусторонний обмен, обработка ошибок, качество документации и требования к мониторингу. Поэтому сначала нужно определить сценарий и проверить технические возможности систем.'],
	['Можно доработать существующую интеграцию?', 'Да. Сначала изучаем код, логи, документацию и известные ошибки, затем предлагаем ремонт, переработку или поэтапную замену.'],
	['Что произойдёт, если одна система временно недоступна?', 'Поведение заранее проектируется для конкретного процесса: повторная отправка, очередь, уведомление ответственного или ручная обработка. Критерии фиксируются до разработки.'],
	['Кто поддерживает обмен после запуска?', 'Можем взять интеграцию на техническую поддержку: следить за ошибками, адаптировать её к изменениям API и подключать новые сценарии.'],
];
---

<DevelopmentServicePage
	source="integrations"
	breadcrumb="Интеграции систем"
	title="Связываем системы бизнеса, чтобы данные передавались без ручной работы"
	intro={[
		'Интегрируем сайты, CRM, ERP, 1С, платежи, телефонию, мессенджеры, складские системы и внешние сервисы.',
		'Проектируем, какие данные должны передаваться, когда запускается обмен, что происходит при ошибке и кто отвечает за результат процесса.',
	]}
	cta="Обсудить интеграцию"
	ctaNote="На первой встрече разберём системы и сценарий обмена, после чего предложим следующий шаг и предварительный порядок бюджета."
	trust={['Сайт, CRM, ERP и 1С', 'Карта обмена до разработки', 'Запуск, документация и поддержка']}
	problemsHeading="Когда сотрудники становятся «живой интеграцией»"
	problems={problems}
	offeringsHeading="Связываем клиентские, учётные и внутренние системы"
	offeringsLead="Состав обмена определяется процессом: от передачи одной заявки до синхронизации заказов, оплат, товаров и статусов между несколькими системами."
	offerings={offerings}
	valuesHeading="От одной связки до единого интеграционного контура"
	values={values}
	cases={cases}
	processHeading="Сначала схема обмена, затем код"
	processLead="Интеграция затрагивает несколько систем и ответственных команд, поэтому критерии готовности и поведение при ошибках определяются заранее."
	process={process}
	reasonsHeading="Что входит в проект интеграции"
	reasons={reasons}
	faqs={faqs}
	related={[
		{ title: 'Сайты', href: '/services/sites/', text: 'Новый клиентский канал с формами, CMS, аналитикой и CRM.' },
		{ title: 'Веб-сервисы', href: '/services/web-services/', text: 'Личные кабинеты, B2B-порталы и внутренние цифровые продукты.' },
		{ title: 'Поддержка', href: '/services/support/', text: 'Мониторинг, исправления и развитие интеграций после запуска.' },
	]}
	finalHeading="Покажите, где сотрудники переносят данные вручную"
	finalText="Разберём текущую цепочку, определим источники данных и предложим безопасный порядок автоматизации."
	finalCta="Получить предварительную оценку"
/>
