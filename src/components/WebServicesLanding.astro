---
import type { ComponentProps } from 'astro/types';
import DevelopmentServicePage from './DevelopmentServicePage.astro';

const problems: ComponentProps<typeof DevelopmentServicePage>['problems'] = [
	{ icon: 'file', title: 'Процесс держится на таблицах и переписке', text: 'Заявки, согласования, документы и статусы находятся в разных файлах и зависят от ручного контроля.' },
	{ icon: 'users', title: 'Клиентам нужен самостоятельный доступ', text: 'Пользователи хотят видеть заказы, документы, оплаты, историю операций и статусы без звонка менеджеру.' },
	{ icon: 'layers', title: 'Готовая платформа ограничивает бизнес', text: 'Не хватает нужных ролей, логики, интеграций или возможностей развития, а процесс приходится подгонять под коробочный продукт.' },
	{ icon: 'rocket', title: 'Нужно проверить цифровой продукт', text: 'Есть идея, но важно быстро определить состав первого релиза и проверить её без разработки лишнего функционала.' },
];

const offerings: ComponentProps<typeof DevelopmentServicePage>['offerings'] = [
	{
		icon: 'users', title: 'Порталы и личные кабинеты', price: 'от 300 000 ₽',
		text: 'Кабинеты для клиентов, партнёров, дилеров, подрядчиков и сотрудников.',
		lists: [{ title: 'Возможности', items: ['регистрация и роли', 'документы, заявки и статусы', 'оплаты и уведомления', 'отчёты и история операций', 'административное управление'] }],
	},
	{
		icon: 'rocket', title: 'MVP цифрового продукта', price: 'от 600 000 ₽',
		text: 'Первый рабочий релиз сервиса, который проверяет ключевую гипотезу и позволяет начать работу с реальными пользователями.',
		lists: [{ title: 'Фокус первого релиза', items: ['одна измеримая задача', 'ключевые роли и сценарии', 'только обязательная бизнес-логика', 'аналитика использования', 'план следующих версий'] }],
	},
	{
		icon: 'settings', title: 'Внутренние сервисы',
		text: 'Системы для заявок, согласований, расчётов, учёта, контроля исполнения и аналитики, созданные под конкретный процесс компании.',
		lists: [{ title: 'Примеры', items: ['управление заявками', 'маршруты согласований', 'калькуляторы и конфигураторы', 'операционные панели', 'аналитические дашборды'] }],
	},
	{
		icon: 'workflow', title: 'Агрегаторы и маркетплейсы',
		text: 'Платформы с несколькими ролями участников, каталогом предложений, заказами, платежами, комиссиями, рейтингами и административным управлением.',
		featured: true,
		lists: [{ title: 'Для B2B и B2C', items: ['личные кабинеты участников', 'каталог и поиск', 'заказы и взаиморасчёты', 'уведомления и статусы', 'интеграции с учётными системами'] }],
	},
];

const values: ComponentProps<typeof DevelopmentServicePage>['values'] = [
	{ icon: 'message', title: 'Интервью и описание процессов', text: 'Фиксируем пользователей, текущую работу, ограничения и ожидаемый результат.' },
	{ icon: 'users', title: 'Роли и сценарии', text: 'Определяем права, ключевые действия и путь каждого типа пользователя.' },
	{ icon: 'filter', title: 'Границы первого релиза', text: 'Отделяем обязательную функциональность от идей, которые можно проверить позже.' },
	{ icon: 'spark', title: 'Прототип и UX/UI', text: 'Проверяем логику до разработки и создаём целостную систему интерфейсов.' },
	{ icon: 'database', title: 'Frontend, backend и данные', text: 'Разрабатываем клиентскую и серверную части, базу данных и административную панель.' },
	{ icon: 'workflow', title: 'API и интеграции', text: 'Связываем продукт с CRM, ERP, 1С, оплатой и другими необходимыми системами.' },
];

const cases = [
	{
		title: 'MVP агрегатора вывоза строительных отходов',
		href: '/cases/ecocaravan-waste-removal-mvp/',
		image: '/cases/ecocaravan/main-image-ecocaravan.webp',
		text: 'Сайт и личные кабинеты для заказчиков, перевозчиков и переработчиков с автоматизацией приёма, расчёта и распределения заявок.',
		result: 'Первый релиз запущен за месяц',
	},
	{
		title: 'MVP финансового трекера WakeUpMoney',
		href: '/cases/wakeupmoney-financial-tracker/',
		image: '/cases/wakeupmoney/main-image-wum.webp',
		text: 'Кроссплатформенный продукт для учёта инвестиций, проектов, целей, сделок и личных финансов.',
		result: 'От идеи и прототипа до работающего MVP',
	},
	{
		title: 'Интерфейс для сети сервисных специалистов',
		href: '/cases/home-assist-service-crm/',
		image: '/cases/home-assist/main-homeassit.webp',
		text: 'CRM/ERP и рабочий интерфейс для распределения заявок между собственной сетью из более чем 5000 исполнителей.',
		result: 'Скорость обработки заявки увеличена на 70%',
	},
];

const process = [
	{ title: 'Определяем пользователей и результат', text: 'Фиксируем, кто будет работать в сервисе, какую задачу решает продукт и по какой метрике оценивается первый запуск.', result: 'Цель продукта и критерии успеха.' },
	{ title: 'Формируем первый релиз', text: 'Отделяем обязательные сценарии от функций, которые можно развивать после проверки гипотезы.', result: 'Приоритизированный состав MVP.' },
	{ title: 'Проектируем данные и архитектуру', text: 'Описываем роли, сущности, связи, интеграции и требования к инфраструктуре.', result: 'Архитектура и функциональные требования.' },
	{ title: 'Собираем прототип', text: 'Проектируем экраны и проверяем ключевые действия пользователя до программирования.', result: 'Интерактивный прототип.' },
	{ title: 'Разрабатываем и тестируем', text: 'Создаём frontend, backend, административную часть и интеграции, проверяем бизнес-логику.', result: 'Рабочая версия на тестовом контуре.' },
	{ title: 'Запускаем пилот', text: 'Подключаем ограниченную группу пользователей, собираем обратную связь и данные.', result: 'Первое использование в реальном процессе.' },
	{ title: 'Развиваем продукт', text: 'Исправляем узкие места и планируем следующие функции по реальному эффекту.', result: 'Управляемая дорожная карта развития.' },
];

const reasons = [
	{ title: 'Начинаем с процесса, а не со списка экранов', text: 'Сервис должен менять конкретную работу пользователя, а не просто переносить существующие таблицы в браузер.' },
	{ title: 'Не перегружаем первый релиз', text: 'Собираем законченную полезную версию и откладываем функции, которые не влияют на проверку главной гипотезы.' },
	{ title: 'Проектируем развитие заранее', text: 'Учитываем новые роли, объём данных, интеграции и возможное увеличение нагрузки.' },
	{ title: 'Одна команда на весь продукт', text: 'Аналитик, дизайнеры, frontend- и backend-разработчики, тестировщик и менеджер работают в общем контексте.' },
	{ title: 'Остаёмся после релиза', text: 'Можем поддерживать продукт, выпускать новые версии и подключать дополнительные системы.' },
];

const faqs: [string, string][] = [
	['Чем веб-сервис отличается от сайта?', 'Сайт в первую очередь представляет информацию и ведёт пользователя к обращению или покупке. В сервисе пользователь авторизуется и выполняет действия с данными: создаёт заявки, получает расчёты, работает с документами, заказами и статусами.'],
	['Обязательно сразу разрабатывать весь продукт?', 'Нет. Обычно безопаснее определить один законченный сценарий первого релиза и проверить его на реальных пользователях.'],
	['Сколько стоит разработка?', 'Личные кабинеты и порталы начинаются от 300 000 ₽, индивидуальные сервисы и MVP — от 600 000 ₽. Точная стоимость зависит от количества ролей, экранов, бизнес-правил, интеграций и требований к инфраструктуре.'],
	['Можно подключить сервис к существующей CRM или 1С?', 'Да, если системы предоставляют подходящий способ обмена. Состав и направление передаваемых данных проектируем отдельно.'],
	['Кому принадлежит исходный код?', 'Права, порядок передачи исходного кода и используемые сторонние компоненты фиксируются в договоре до начала разработки.'],
	['Что происходит после запуска?', 'Можем продолжить работу в формате поддержки и развития: устранять ошибки, анализировать использование, добавлять сценарии и подключать новые системы.'],
];
---

<DevelopmentServicePage
	source="web-services"
	breadcrumb="Веб-сервисы"
	title="Разрабатываем веб-сервисы под процессы вашей компании"
	intro={[
		'Создаём личные кабинеты, B2B-порталы, MVP, агрегаторы и внутренние системы, когда готового продукта недостаточно или он заставляет бизнес работать по чужим правилам.',
		'Начинаем с ключевого сценария и первого полезного релиза. Проектируем роли, интерфейсы, данные и интеграции, затем развиваем продукт по результатам реального использования.',
	]}
	cta="Обсудить веб-сервис"
	ctaNote="Опишите пользователей, текущий порядок работы и желаемый результат. Поможем определить границы первого релиза."
	trust={['Личные кабинеты от 300 000 ₽', 'MVP от 600 000 ₽', 'Frontend, backend и интеграции']}
	problemsHeading="Когда готового продукта уже недостаточно"
	problems={problems}
	offeringsHeading="Разрабатываем сервисы для клиентов, партнёров и сотрудников"
	offeringsLead="Название продукта может быть любым — важнее пользователи, ключевой сценарий и измеримый результат для бизнеса."
	offerings={offerings}
	valuesHeading="Берём на себя весь цикл создания продукта"
	values={values}
	cases={cases}
	processHeading="Сначала полезный сценарий, затем расширение продукта"
	processLead="Поэтапный запуск сокращает риск лишней разработки и быстрее даёт обратную связь от реальных пользователей."
	process={process}
	reasonsHeading="Проектируем сервис как развивающийся продукт"
	reasons={reasons}
	faqs={faqs}
	related={[
		{ title: 'Сайты', href: '/services/sites/', text: 'Лендинги, корпоративные сайты, магазины и интерактивные проекты.' },
		{ title: 'Интеграции', href: '/services/integrations/', text: 'Связь продукта с CRM, ERP, 1С, оплатой и внешними сервисами.' },
		{ title: 'Поддержка', href: '/services/support/', text: 'Развитие, исправления и технические работы после запуска.' },
	]}
	finalHeading="Есть идея сервиса или процесс, который пора оцифровать?"
	finalText="Опишите пользователей, текущий порядок работы и желаемый результат. Поможем определить границы первого релиза и подготовим предварительную оценку."
	finalCta="Обсудить первый релиз"
/>
