---
import UiIcon from './UiIcon.astro';

const assetBase = '/ds-v2/assets/decorations-split';

const steps = [
	{
		circle: 'deco-circle-01.png',
		digit: 'deco-digit-1.png',
		title: 'Диагностика',
		text: 'Разбираем задачу, ограничения, текущие процессы и точки потерь.',
	},
	{
		circle: 'deco-circle-02.png',
		digit: 'deco-digit-2.png',
		title: 'Проектирование',
		text: 'Определяем архитектуру, роли, маршруты, интерфейсы и состав решения.',
	},
	{
		circle: 'deco-circle-03.png',
		digit: 'deco-digit-3.png',
		title: 'Реализация',
		text: 'Разрабатываем, внедряем, настраиваем и интегрируем.',
	},
	{
		circle: 'deco-circle-04.png',
		digit: 'deco-digit-4.png',
		title: 'Запуск и обучение',
		text: 'Тестируем, переносим данные, обучаем команду и сопровождаем старт.',
	},
	{
		circle: 'deco-circle-01.png',
		digit: 'deco-digit-5.png',
		title: 'Развитие',
		text: 'Добавляем новые функции, оптимизируем процессы и поддерживаем систему.',
	},
] as const;

const connectors = [
	{ image: 'deco-underline-02.png', transform: 'rotate(-4deg)' },
	{ image: 'deco-underline-01.png', transform: 'rotate(3deg)' },
	{ image: 'deco-underline-03.png', transform: 'rotate(-3deg)' },
	{ image: 'deco-underline-02.png', transform: 'rotate(5deg) scaleX(-1)' },
] as const;
---

<section class="implementation-section" aria-labelledby="implementation-title">
	<div class="implementation-container">

		<div class="implementation-header">
			<div>
				<h2 id="implementation-title">
					Пять этапов<br />магии интегратора
				</h2>
			</div>
			<div>
				<p>
					Вместо длинной абстрактной схемы показываем управляемый проект: что делаем, что проверяем
					и где фиксируем результат.
				</p>
				<a class="ds-btn ds-btn-primary" href="#consultation">
					<span>Собрать состав работ</span>
					<UiIcon name="arrow" class="h-[28px] w-[28px]" />
				</a>
			</div>
		</div>

		<div class="implementation-scroll">
			<ol class="implementation-track" aria-label="Этапы внедрения">
				{steps.map((step, index) => (
					<>
						<li class="implementation-card">
							<div class="implementation-circle">
								<div class="implementation-circle-inner">
									<img src={`${assetBase}/${step.circle}`} alt="" aria-hidden="true" loading="lazy" decoding="async" />
									<div>
										<span>Этап</span>
										<img src={`${assetBase}/${step.digit}`} alt={String(index + 1)} loading="lazy" decoding="async" />
									</div>
								</div>
							</div>
							<h3>{step.title}</h3>
							<p>{step.text}</p>
						</li>

						{connectors[index] && (
							<li class="implementation-connector" aria-hidden="true">
								<img
									src={`${assetBase}/${connectors[index].image}`}
									alt=""
									loading="lazy"
									decoding="async"
									style={`transform:${connectors[index].transform};`}
								/>
							</li>
						)}
					</>
				))}
			</ol>
		</div>
	</div>
</section>

<style>
	.implementation-section {
		overflow: hidden;
		background: var(--ittn-cloud);
	}

	.implementation-container {
		max-width: 1440px;
		margin: 0 auto;
		padding: 88px 24px;
	}

	.implementation-kicker {
		font-family: 'JetBrains Mono', var(--ds-font-mono, monospace);
		text-transform: uppercase;
	}

	.implementation-kicker {
		margin: 0 0 16px;
		color: #232bff;
		font-size: 13px;
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: 0.14em;
	}

	.implementation-header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 64px;
		align-items: start;
		margin-bottom: 80px;
	}

	.implementation-header h2 {
		margin: 0;
		color: #111111;
		font-size: clamp(34px, 5vw, 52px);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: 0;
	}

	.implementation-header p {
		margin: 0 0 28px;
		color: #626977;
		font-size: 18px;
		line-height: 1.55;
	}

	.implementation-track {
		display: flex;
		align-items: flex-start;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.implementation-card {
		display: flex;
		flex: 1 1 0;
		min-width: 0;
		flex-direction: column;
		padding: 0 12px;
	}

	.implementation-circle {
		display: flex;
		justify-content: center;
		margin-bottom: 20px;
	}

	.implementation-circle-inner {
		position: relative;
		width: 104px;
		height: 104px;
		flex: none;
	}

	.implementation-circle-inner > img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.implementation-circle-inner > div {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2px;
	}

	.implementation-circle-inner span {
		color: #626977;
		font-family: 'JetBrains Mono', var(--ds-font-mono, monospace);
		font-size: 9px;
		font-weight: 500;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.implementation-circle-inner div img {
		width: auto;
		height: 40px;
		object-fit: contain;
	}

	.implementation-card h3 {
		margin: 0 0 10px;
		color: #111111;
		font-size: 17px;
		font-weight: 700;
		line-height: 1.2;
	}

	.implementation-card p {
		margin: 0;
		color: #626977;
		font-size: 14px;
		line-height: 1.6;
	}

	.implementation-connector {
		display: flex;
		height: 104px;
		flex: none;
		align-items: center;
	}

	.implementation-connector img {
		width: 56px;
		height: auto;
		opacity: 0.45;
	}

	:global(.dark) .implementation-section {
		background: #10131d;
	}

	:global(.dark) .implementation-header h2,
	:global(.dark) .implementation-card h3 {
		color: #ffffff;
	}

	:global(.dark) .implementation-header p,
	:global(.dark) .implementation-card p,
	:global(.dark) .implementation-circle-inner span {
		color: #aeb6c8;
	}

	@media (max-width: 767px) {
		.implementation-container {
			padding: 72px 24px;
		}

		.implementation-header {
			grid-template-columns: 1fr;
			gap: 24px;
			margin-bottom: 48px;
		}

		.implementation-header h2 {
			font-size: clamp(34px, 10vw, 44px);
		}

		.implementation-header p {
			font-size: 16px;
		}

		.implementation-scroll {
			margin: 0 -24px;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
		}

		.implementation-scroll::-webkit-scrollbar {
			display: none;
		}

		.implementation-track {
			padding: 0 24px 24px;
		}

		.implementation-card {
			flex: 0 0 185px;
			scroll-snap-align: start;
		}

		.implementation-connector img {
			width: 36px;
		}
	}
</style>
