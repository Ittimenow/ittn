---
const reasons = [
	{
		title: 'Объединяем разработку и автоматизацию',
		text: 'Не нужно искать отдельно студию, интегратора, разработчиков и поддержку.',
	},
	{
		title: 'Работаем от бизнес-процесса',
		text: 'Сначала разбираем задачу, затем проектируем решение и только потом внедряем.',
	},
	{
		title: 'Подбираем платформу под модель бизнеса',
		text: 'Bitrix24, РосБизнесСофт, ЭЛМА или кастомная разработка выбираются по задаче.',
	},
	{
		title: 'Закрываем полный цикл',
		text: 'Аудит, проектирование, разработка, интеграции, запуск, обучение и развитие.',
	},
];
---

<section class="trust-reasons py-16 sm:py-24">
	<div class="mx-auto max-w-[1440px] px-6">
		<div class="trust-reasons-panel">
			<div class="mb-10 max-w-3xl">
				<p class="home-section-kicker">Почему нам доверяют</p>
				<h2 class="home-section-title">
					К нам приходят не за ещё одним подрядчиком, а за системой
				</h2>
			</div>

			<div class="home-mobile-carousel grid gap-4 md:grid-cols-2">
				{reasons.map((reason, index) => (
					<article class="home-swipe-card trust-reason-card flex items-start gap-5 rounded-2xl border border-black/12 bg-black/[0.04] p-6">
						<span
							class="trust-reason-digit h-16 w-16 shrink-0"
							style={`--digit-url: url('/ds-v2/assets/digit-${index + 1}.png');`}
							aria-hidden="true"
						></span>
						<div>
							<h3 class="home-trust-card-title">{reason.title}</h3>
							<p class="mt-3">{reason.text}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.trust-reasons-panel {
		border-radius: var(--ittn-radius-lg);
		background: var(--ittn-acid);
		padding: 32px;
		color: #111111;
	}

	.trust-reasons :global(.home-section-kicker) {
		color: #111111;
	}

	.trust-reasons :global(.home-section-title),
	.trust-reason-card :global(.home-trust-card-title) {
		color: #111111;
	}

	.trust-reason-card p {
		color: #111111;
		font-size: 15px;
		line-height: 1.65;
	}

	.trust-reason-digit {
		display: block;
		background: #ffffff;
		mask: var(--digit-url) center / contain no-repeat;
		-webkit-mask: var(--digit-url) center / contain no-repeat;
	}

	@media (max-width: 640px) {
		.trust-reasons-panel {
			margin: 0 -12px;
			padding: 24px 18px;
		}

		.trust-reasons :global(.home-swipe-card) {
			border-color: rgba(17, 17, 17, 0.12);
			background: rgba(17, 17, 17, 0.04);
		}

		.trust-reasons :global(.home-swipe-card::before) {
			display: none;
		}
	}
</style>
