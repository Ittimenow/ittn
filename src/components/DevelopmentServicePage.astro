---
import ServiceHeroVisual from './ServiceHeroVisual.astro';
import ServiceTimeline from './ServiceTimeline.astro';
import ServiceCta from './ServiceCta.astro';
import UiIcon from './UiIcon.astro';
import ClientLogos from './ClientLogos.astro';

type IconName =
	| 'arrow'
	| 'bar-chart'
	| 'briefcase'
	| 'check'
	| 'cloud'
	| 'database'
	| 'file'
	| 'filter'
	| 'layers'
	| 'lock'
	| 'message'
	| 'phone'
	| 'rocket'
	| 'settings'
	| 'shield'
	| 'spark'
	| 'thumbs-up'
	| 'users'
	| 'workflow';

interface Problem {
	icon: IconName;
	title: string;
	text: string;
}

interface OfferingList {
	title: string;
	items: string[];
}

interface Offering {
	icon: IconName;
	title: string;
	price?: string;
	text: string;
	lists?: OfferingList[];
	featured?: boolean;
}

interface ValueItem {
	icon: IconName;
	title: string;
	text: string;
}

interface CaseItem {
	title: string;
	href: string;
	image: string;
	text: string;
	result?: string;
}

interface ProcessItem {
	title: string;
	text: string;
	result?: string;
}

interface ReasonItem {
	title: string;
	text: string;
}

interface RelatedItem {
	title: string;
	href: string;
	text: string;
}

interface Props {
	source: 'sites' | 'web-services' | 'integrations';
	breadcrumb: string;
	title: string;
	intro: string[];
	cta: string;
	ctaNote: string;
	trust: string[];
	problemsHeading: string;
	problemsLead?: string;
	problems: Problem[];
	offeringsHeading: string;
	offeringsLead?: string;
	offerings: Offering[];
	valuesHeading: string;
	valuesLead?: string;
	values: ValueItem[];
	casesHeading?: string;
	cases: CaseItem[];
	processHeading: string;
	processLead?: string;
	process: ProcessItem[];
	reasonsHeading: string;
	reasonsLead?: string;
	reasons: ReasonItem[];
	faqs: [string, string][];
	related: RelatedItem[];
	finalHeading: string;
	finalText: string;
	finalCta: string;
}

const {
	source,
	breadcrumb,
	title,
	intro,
	cta,
	ctaNote,
	trust,
	problemsHeading,
	problemsLead,
	problems,
	offeringsHeading,
	offeringsLead,
	offerings,
	valuesHeading,
	valuesLead,
	values,
	casesHeading = 'Показываем результат на реальных проектах',
	cases,
	processHeading,
	processLead,
	process,
	reasonsHeading,
	reasonsLead,
	reasons,
	faqs,
	related,
	finalHeading,
	finalText,
	finalCta,
} = Astro.props;

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(([question, answer]) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<div class="development-service-page">
	<section class="service-particle-hero overflow-hidden border-b border-neutral-200 bg-white">
		<div class="service-particle-grid mx-auto grid min-h-[calc(100vh-96px)] max-w-[1440px] items-center px-6 py-16 sm:py-20 lg:py-24">
			<div class="max-w-5xl">
				<nav class="service-breadcrumbs" aria-label="Хлебные крошки">
					<a href="/services/">Все услуги</a>
					<UiIcon name="chevron" class="h-[24.5px] w-[24.5px]" />
					<strong aria-current="page">{breadcrumb}</strong>
				</nav>
				<h1 class="max-w-5xl text-neutral-950">{title}</h1>
				<div class="mt-7 grid max-w-3xl gap-3 text-lg leading-8 text-neutral-700 sm:text-xl">
					{intro.map((paragraph) => <p>{paragraph}</p>)}
				</div>
				<div class="mt-8">
					<button
						class="ds-btn ds-btn-primary consultation-trigger"
						type="button"
						data-b24-form-trigger
						data-service-cta
						data-service-source={source}
					>
						<span>{cta}</span>
						<UiIcon name="arrow" class="h-[28px] w-[28px]" />
					</button>
					<p class="mt-4 max-w-2xl text-sm leading-6 text-neutral-500">{ctaNote}</p>
				</div>
			<div class="service-card-row mt-9 grid gap-3 sm:grid-cols-3">
					{trust.map((item) => (
						<p class="rounded-2xl border border-neutral-200 bg-neutral-50 p-4 text-sm font-bold leading-6 text-neutral-800">{item}</p>
					))}
				</div>
			</div>
			<ServiceHeroVisual scene={source} />
		</div>
	</section>

	<section class="border-b border-neutral-200 bg-neutral-50">
		<div class="mx-auto max-w-[1440px] px-6 py-16 sm:py-24">
			<div class="max-w-4xl">
				<h2 class="mt-4">{problemsHeading}</h2>
				{problemsLead && <p class="mt-5 max-w-3xl text-lg leading-8 text-neutral-700">{problemsLead}</p>}
			</div>
			<div class="service-card-row mt-10 grid gap-4 md:grid-cols-2">
				{problems.map((problem) => (
					<article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-[0_20px_50px_-36px_rgba(17,17,17,0.3)]">
						<div class="grid h-11 w-11 place-items-center">
							<UiIcon name={problem.icon} class="h-[35px] w-[35px]" />
						</div>
						<h3 class="mt-5 text-xl">{problem.title}</h3>
						<p class="mt-3 text-base leading-7 text-neutral-600">{problem.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-[1440px] px-6 py-16 sm:py-24">
		<div class="max-w-4xl">
			<h2 class="mt-4">{offeringsHeading}</h2>
			{offeringsLead && <p class="mt-5 max-w-3xl text-lg leading-8 text-neutral-700">{offeringsLead}</p>}
		</div>
		<div class="service-card-row mt-10 grid gap-5 lg:grid-cols-2">
			{offerings.map((offering) => (
				<article class:list={[
					'flex flex-col rounded-2xl border p-6 transition hover:-translate-y-1 hover:shadow-[0_30px_70px_-38px_rgba(35,43,255,0.45)]',
					offering.featured ? 'border-indigo-600 bg-indigo-600 text-white ui-icon-contrast' : 'border-neutral-200 bg-white',
				]}>
					<div class="grid h-11 w-11 place-items-center">
						<UiIcon name={offering.icon} class="h-[35px] w-[35px]" />
					</div>
					<h3 class:list={['mt-5 text-2xl', offering.featured && 'text-white']}>{offering.title}</h3>
					{offering.price && <p class:list={['mt-2 text-2xl font-bold', offering.featured ? 'text-white' : 'text-indigo-600']}>{offering.price}</p>}
					<p class:list={['mt-4 leading-7', offering.featured ? 'text-white/85' : 'text-neutral-600']}>{offering.text}</p>
					{offering.lists && (
						<div class:list={['mt-6 grid gap-5', offering.lists.length > 1 && 'sm:grid-cols-2']}>
							{offering.lists.map((list) => (
								<div>
									<p class="text-sm font-bold">{list.title}</p>
									<ul class="mt-3 grid gap-2 text-sm leading-6">
										{list.items.map((item) => (
											<li class="flex gap-2">
												<UiIcon name="check" class="mt-1 h-[28px] w-[28px] shrink-0" />
												<span>{item}</span>
											</li>
										))}
									</ul>
								</div>
							))}
						</div>
					)}
				</article>
			))}
		</div>
	</section>

	<section class="border-y border-neutral-200 bg-neutral-50">
		<div class="mx-auto max-w-[1440px] px-6 py-16 sm:py-24">
			<div class="max-w-4xl">
				<h2 class="mt-4">{valuesHeading}</h2>
				{valuesLead && <p class="mt-5 max-w-3xl text-lg leading-8 text-neutral-700">{valuesLead}</p>}
			</div>
			<div class="service-card-row mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
				{values.map((item) => (
					<article class="rounded-2xl border border-neutral-200 bg-white p-6">
						<div class="grid h-11 w-11 place-items-center">
							<UiIcon name={item.icon} class="h-[35px] w-[35px]" />
						</div>
						<h3 class="mt-5 text-xl">{item.title}</h3>
						<p class="mt-3 text-sm leading-6 text-neutral-600">{item.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-[1440px] px-6 py-16 sm:py-24">
		<div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<h2 class="mt-4 max-w-4xl">{casesHeading}</h2>
			</div>
			<a href="/cases/" class="text-sm font-bold text-indigo-600 hover:text-indigo-800">Все кейсы</a>
		</div>
		<div class="service-card-row mt-10 grid gap-6 lg:grid-cols-3">
			{cases.map((item) => (
				<article class="overflow-hidden rounded-2xl border border-neutral-200 bg-white transition hover:-translate-y-1 hover:shadow-[0_30px_70px_-38px_rgba(35,43,255,0.45)]">
					<a href={item.href} class="block overflow-hidden">
						<img class="aspect-[4/3] w-full object-cover transition duration-500 hover:scale-105" src={item.image} alt={item.title} loading="lazy" decoding="async" />
					</a>
					<div class="p-6">
						<h3 class="text-xl">{item.title}</h3>
						<p class="mt-3 text-sm leading-6 text-neutral-600">{item.text}</p>
						{item.result && <p class="mt-5 rounded-xl bg-neutral-50 px-4 py-3 text-sm font-bold text-neutral-950">{item.result}</p>}
						<a class="mt-5 inline-flex text-sm font-bold text-indigo-600 hover:text-indigo-800" href={item.href}>Смотреть кейс →</a>
					</div>
				</article>
			))}
		</div>
	</section>

	<ServiceTimeline title={processHeading} text={processLead} steps={process} />

	<section class="mx-auto max-w-[1440px] px-6 py-16 sm:py-24">
		<div class="rounded-[32px] bg-neutral-950 p-6 text-white sm:p-10">
			<div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
				<div>
					<h2 class="mt-4 !text-white">{reasonsHeading}</h2>
					{reasonsLead && <p class="mt-5 text-lg leading-8 text-white/70">{reasonsLead}</p>}
				</div>
				<div class="service-card-row grid gap-4">
					{reasons.map((item, index) => (
						<article class="grid gap-4 rounded-2xl border border-white/15 bg-white/[0.06] p-5 sm:grid-cols-[48px_minmax(0,1fr)]">
							<span class="text-2xl font-bold text-indigo-300">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<h3 class="text-xl !text-white">{item.title}</h3>
								<p class="mt-2 text-sm leading-6 text-white/70">{item.text}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="border-y border-neutral-200 bg-neutral-50">
		<div class="mx-auto grid max-w-[1440px] gap-8 px-6 py-16 sm:py-24 lg:grid-cols-[0.72fr_1fr] lg:items-start">
			<div>
				<h2 class="mt-4">Частые вопросы перед стартом</h2>
				<p class="mt-5 text-lg leading-8 text-neutral-700">Если не нашли свой вопрос, опишите задачу — разберём её на первой встрече.</p>
			</div>
			<div class="grid gap-3">
				{faqs.map(([question, answer]) => (
					<details class="group rounded-2xl border border-neutral-200 bg-white px-5 py-4">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-neutral-950">
							<span>{question}</span>
							<span class="text-xl text-indigo-600 transition group-open:rotate-45" aria-hidden="true">+</span>
						</summary>
						<p class="pt-4 text-sm leading-7 text-neutral-600">{answer}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-[1440px] px-6 py-16 sm:py-24">
		<div class="max-w-4xl">
			<h2 class="mt-4">Возможно, вам также нужно</h2>
		</div>
		<div class="service-card-row mt-8 grid gap-4 md:grid-cols-3">
			{related.map((item) => (
				<a href={item.href} class="group rounded-2xl border border-neutral-200 bg-white p-6 transition hover:-translate-y-1 hover:border-indigo-300 hover:shadow-[0_24px_60px_-38px_rgba(35,43,255,0.45)]">
					<h3 class="text-xl group-hover:text-indigo-600">{item.title}</h3>
					<p class="mt-3 text-sm leading-6 text-neutral-600">{item.text}</p>
					<span class="mt-5 inline-flex text-sm font-bold text-indigo-600">Подробнее →</span>
				</a>
			))}
		</div>
	</section>

	<ClientLogos />

	<ServiceCta title={finalHeading} text={finalText} label={finalCta} source={source} />
</div>

<script>
	function bindDevelopmentServiceTracking() {
		document.querySelectorAll<HTMLElement>('[data-service-cta]').forEach((button) => {
			if (button.dataset.trackingBound) return;
			button.dataset.trackingBound = '1';
			button.addEventListener('click', () => {
				const trackingWindow = window as Window & { dataLayer?: Record<string, string>[] };
				trackingWindow.dataLayer ??= [];
				trackingWindow.dataLayer.push({
					event: 'service_cta_click',
					service: button.dataset.serviceSource ?? 'development',
					cta: button.textContent?.trim() ?? '',
				});
			});
		});
	}

	bindDevelopmentServiceTracking();
	document.addEventListener('astro:page-load', bindDevelopmentServiceTracking);
</script>

<style>
	.development-service-page h1 {
		font-size: clamp(44px, 7.4vw, 96px);
		line-height: 0.94;
		text-wrap: balance;
	}

	.development-service-page h2,
	.development-service-page h3 {
		text-wrap: balance;
	}
</style>
