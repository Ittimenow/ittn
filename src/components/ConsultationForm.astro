---
import UiIcon from './UiIcon.astro';
---

<section id="consultation" class="mx-auto max-w-[1440px] px-6 py-16 sm:py-24">
	<div class="grid gap-10 md:grid-cols-2">
		<div>
			<p class="home-section-kicker">Консультация</p>
			<h2 class="home-section-title">Обсудим, с чего начать</h2>
			<p class="home-section-copy">
				Поможем понять, что нужно на старте: сайт, CRM, ERP, интеграции
				или аудит процессов.
			</p>
			<dl class="mt-6 space-y-3 text-sm">
				<div class="flex gap-3">
					<dt class="w-20 text-neutral-500">Телефон</dt>
					<dd>
						<a href="tel:+74951335888" class="font-medium hover:text-indigo-600 dark:hover:text-indigo-400">
							+7 (495) 133-58-88
						</a>
					</dd>
				</div>
				<div class="flex gap-3">
					<dt class="w-20 text-neutral-500">Email</dt>
					<dd>
						<a href="mailto:hello@ittimenow.com" class="font-medium hover:text-indigo-600 dark:hover:text-indigo-400">
							hello@ittimenow.com
						</a>
					</dd>
				</div>
			</dl>
		</div>

		<form class="grid gap-4" method="post" action="#" novalidate data-consultation-form>
			<label class="grid gap-1.5 text-sm" data-field>
				<span class="text-neutral-700 dark:text-neutral-300">Имя</span>
				<input
					required
					type="text"
					name="name"
					autocomplete="name"
					data-trimmed-required
					data-error-message="Введите имя"
					class="rounded-lg border border-neutral-200 bg-white px-3.5 py-2.5 text-sm outline-none transition focus:border-indigo-500 focus:shadow-[0_0_0_4px_rgba(35,43,255,0.12)] dark:border-neutral-800 dark:bg-neutral-900"
				/>
				<span class="hidden text-xs leading-5 text-red-600" data-field-error></span>
			</label>
			<label class="grid gap-1.5 text-sm" data-field>
				<span class="text-neutral-700 dark:text-neutral-300">Компания</span>
				<input
					type="text"
					name="company"
					autocomplete="organization"
					data-trim-on-blur
					class="rounded-lg border border-neutral-200 bg-white px-3.5 py-2.5 text-sm outline-none transition focus:border-indigo-500 focus:shadow-[0_0_0_4px_rgba(35,43,255,0.12)] dark:border-neutral-800 dark:bg-neutral-900"
				/>
				<span class="hidden text-xs leading-5 text-red-600" data-field-error></span>
			</label>
			<label class="grid gap-1.5 text-sm" data-field>
				<span class="text-neutral-700 dark:text-neutral-300">Телефон</span>
				<span class="flex items-center rounded-lg border border-neutral-200 bg-white transition focus-within:border-indigo-500 focus-within:shadow-[0_0_0_4px_rgba(35,43,255,0.12)] dark:border-neutral-800 dark:bg-neutral-900" data-control-frame>
					<span class="shrink-0 py-2.5 pl-3.5 pr-1 text-sm font-medium text-neutral-500 dark:text-neutral-400">
						+7
					</span>
					<input
						required
						type="tel"
						name="phone"
						inputmode="numeric"
						autocomplete="tel-national"
						pattern="[0-9]{3} [0-9]{3} [0-9]{4}"
						maxlength="12"
						title="Введите 10 цифр телефона без +7"
						placeholder="999 123 4567"
						data-phone-digits
						data-error-message="Введите 10 цифр телефона без +7, например +7 999 123 4567"
						class="min-w-0 flex-1 border-0 bg-transparent py-2.5 pl-1 pr-3.5 text-sm outline-none focus:border-transparent focus:shadow-none focus-visible:outline-none"
					/>
				</span>
				<span class="hidden text-xs leading-5 text-red-600" data-field-error></span>
			</label>
			<label class="grid gap-1.5 text-sm" data-field>
				<span class="text-neutral-700 dark:text-neutral-300">Email</span>
				<input
					type="email"
					name="email"
					autocomplete="email"
					pattern="[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}"
					title="Введите email латиницей, например hello@company.ru"
					placeholder="hello@company.ru"
					data-email-latin
					data-error-message="Введите полный email латиницей, например hello@company.ru"
					class="rounded-lg border border-neutral-200 bg-white px-3.5 py-2.5 text-sm outline-none transition focus:border-indigo-500 focus:shadow-[0_0_0_4px_rgba(35,43,255,0.12)] dark:border-neutral-800 dark:bg-neutral-900"
				/>
				<span class="hidden text-xs leading-5 text-red-600" data-field-error></span>
			</label>
			<label class="grid gap-1.5 text-sm" data-field>
				<span class="text-neutral-700 dark:text-neutral-300">Коротко о задаче</span>
				<textarea
					name="message"
					rows="4"
					data-trim-on-blur
					class="rounded-lg border border-neutral-200 bg-white px-3.5 py-2.5 text-sm outline-none transition focus:border-indigo-500 focus:shadow-[0_0_0_4px_rgba(35,43,255,0.12)] dark:border-neutral-800 dark:bg-neutral-900"
				></textarea>
				<span class="hidden text-xs leading-5 text-red-600" data-field-error></span>
			</label>
			<button
				type="submit"
				class="ds-btn ds-btn-primary mt-2 disabled:cursor-not-allowed disabled:border-neutral-200 disabled:bg-neutral-100 disabled:text-neutral-400 disabled:hover:translate-y-0"
				data-consultation-submit
				disabled
			>
				<span>Отправить заявку</span>
				<UiIcon name="arrow" class="h-4 w-4" />
			</button>
			<p class="hidden rounded-lg border px-4 py-3 text-sm leading-6" data-consultation-status role="status" aria-live="polite"></p>
			<div class="rounded-lg border border-neutral-200 bg-white p-4 text-xs leading-5 text-neutral-600 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-400" data-field>
				<label class="flex gap-3">
					<input
						required
						type="checkbox"
						name="personal_data_consent"
						value="accepted"
						class="mt-0.5 h-5 w-5 shrink-0 rounded-md border-neutral-300 text-indigo-600 focus:ring-indigo-500 dark:border-neutral-700"
						data-consent-checkbox
						data-error-message="Подтвердите согласие на обработку персональных данных"
					/>
					<span>
						Я даю согласие оператору IT TIME NOW, адрес: 117105, Москва, Варшавское ш., 28А, на обработку моих персональных данных: имя, телефон, email, компания, содержание обращения. Цель обработки — связь со мной, консультация и подготовка ответа на заявку. Разрешенные действия: сбор, запись, систематизация, накопление, хранение, уточнение, использование, передача сервисам связи и CRM, блокирование, удаление и уничтожение с использованием средств автоматизации и без них. Согласие действует до достижения цели обработки или до отзыва; отзыв можно направить на <a href="mailto:hello@ittimenow.com" class="font-medium text-indigo-600 underline underline-offset-2">hello@ittimenow.com</a>.
					</span>
				</label>
				<span class="mt-2 hidden text-xs leading-5 text-red-600" data-field-error></span>
			</div>
			<p class="text-xs text-neutral-500">
				Свяжемся в рабочее время, обсудим задачу, предложим варианты и следующий шаг.
			</p>
		</form>
	</div>
</section>

<script>
	const bindConsultationFormInputs = () => {
		const normalizePhoneDigits = (value) => {
			let digits = value.replace(/\D/g, '');
			if (digits.length > 10 && /^[78]/.test(digits)) digits = digits.slice(1);

			return digits.slice(0, 10);
		};

		const formatPhoneDigits = (digits) => [
			digits.slice(0, 3),
			digits.slice(3, 6),
			digits.slice(6, 10),
		].filter(Boolean).join(' ');

		const errorClasses = ['border-red-500', 'focus:border-red-500', 'focus:shadow-[0_0_0_4px_rgba(226,61,79,0.14)]'];
		const normalClasses = ['border-neutral-200', 'focus:border-indigo-500', 'focus:shadow-[0_0_0_4px_rgba(35,43,255,0.12)]'];

		const getField = (input) => input.closest('[data-field]');
		const getControl = (input) => input.closest('[data-field]')?.querySelector('[data-control-frame]') || input;
		const getError = (input) => input.closest('[data-field]')?.querySelector('[data-field-error]');

		const setFieldError = (input, message = '') => {
			const error = getError(input);
			const control = getControl(input);
			if (!(control instanceof HTMLElement) || !(error instanceof HTMLElement)) return;

			if (message) {
				error.textContent = message;
				error.classList.remove('hidden');
				control.classList.remove(...normalClasses);
				control.classList.add(...errorClasses);
				input.setAttribute('aria-invalid', 'true');
				return;
			}

			error.textContent = '';
			error.classList.add('hidden');
			control.classList.remove(...errorClasses);
			control.classList.add(...normalClasses);
			input.removeAttribute('aria-invalid');
		};

		const trimValue = (input) => {
			if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) {
				input.value = input.value.trim().replace(/\s{2,}/g, ' ');
			}
		};

		const validateField = (input, showError = true) => {
			if (!(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement)) return true;

			if (input.hasAttribute('data-trimmed-required') || input.hasAttribute('data-trim-on-blur')) trimValue(input);

			let message = '';
			if (input.hasAttribute('data-trimmed-required') && !input.value.trim()) {
				message = input.dataset.errorMessage || 'Заполните поле';
			}

			if (!message && input.hasAttribute('data-phone-digits')) {
				const digits = normalizePhoneDigits(input.value);
				input.value = formatPhoneDigits(digits);
				if (digits.length !== 10) {
					message = input.dataset.errorMessage || 'Введите телефон полностью';
				}
			}

			if (!message && input.hasAttribute('data-email-latin')) {
				input.value = input.value.trim().replace(/[^A-Za-z0-9@._%+\-]/g, '');
				const emailPattern = /^[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}$/;
				if (input.value && !emailPattern.test(input.value)) {
					message = input.dataset.errorMessage || 'Введите email полностью';
				}
			}

			if (!message && input.hasAttribute('data-consent-checkbox') && !input.checked) {
				message = input.dataset.errorMessage || 'Подтвердите согласие';
			}

			if (showError) setFieldError(input, message);
			return !message;
		};

		const updateSubmitState = (form) => {
			const button = form.querySelector('[data-consultation-submit]');
			const consent = form.querySelector('[data-consent-checkbox]');
			if (button instanceof HTMLButtonElement && consent instanceof HTMLInputElement) {
				button.disabled = !consent.checked;
			}
		};

		const setFormStatus = (form, type, message = '') => {
			const status = form.querySelector('[data-consultation-status]');
			if (!(status instanceof HTMLElement)) return;

			status.textContent = message;
			status.classList.toggle('hidden', !message);
			status.classList.remove(
				'border-emerald-200',
				'bg-emerald-50',
				'text-emerald-800',
				'border-red-200',
				'bg-red-50',
				'text-red-700',
			);

			if (type === 'success') {
				status.classList.add('border-emerald-200', 'bg-emerald-50', 'text-emerald-800');
			}

			if (type === 'error') {
				status.classList.add('border-red-200', 'bg-red-50', 'text-red-700');
			}
		};

		const validateForm = (form) => {
			const inputs = [...form.querySelectorAll('input, textarea')];
			const isValid = inputs.reduce((valid, input) => validateField(input, true) && valid, true);
			updateSubmitState(form);

			if (!isValid) {
				const firstInvalid = inputs.find((input) => input instanceof HTMLElement && input.getAttribute('aria-invalid') === 'true');
				if (firstInvalid instanceof HTMLElement) firstInvalid.focus();
			}

			return isValid;
		};

		document.querySelectorAll('[data-consultation-form]').forEach((form) => {
			if (!(form instanceof HTMLFormElement) || form.dataset.consultationFormBound) return;
			form.dataset.consultationFormBound = '1';

			form.querySelectorAll('input, textarea').forEach((input) => {
				if (!(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement)) return;

				input.addEventListener('input', () => {
					if (input.hasAttribute('data-phone-digits')) {
						input.value = formatPhoneDigits(normalizePhoneDigits(input.value));
					}

					if (input.hasAttribute('data-email-latin')) {
						input.value = input.value.replace(/[^A-Za-z0-9@._%+\-]/g, '');
					}

					setFieldError(input);
					updateSubmitState(form);
				});

				input.addEventListener('change', () => {
					updateSubmitState(form);
					if (input.hasAttribute('data-consent-checkbox')) validateField(input);
				});

				input.addEventListener('focusout', () => {
					validateField(input);
					updateSubmitState(form);
				});
			});

			form.querySelectorAll('[data-phone-digits]').forEach((input) => {
				if (!(input instanceof HTMLInputElement)) return;

				input.addEventListener('paste', (event) => {
					const pastedText = event.clipboardData?.getData('text');
					if (!pastedText) return;

					event.preventDefault();
					input.value = formatPhoneDigits(normalizePhoneDigits(pastedText));
					setFieldError(input);
				});
			});

			form.addEventListener('consultation:validate', (event) => {
				if (!validateForm(form)) event.preventDefault();
			});

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				setFormStatus(form, null);
				if (!validateForm(form)) return;

				const button = form.querySelector('[data-consultation-submit]');
				const buttonLabel = button?.querySelector('span');
				const originalLabel = buttonLabel?.textContent || 'Отправить заявку';

				if (button instanceof HTMLButtonElement) button.disabled = true;
				if (buttonLabel instanceof HTMLElement) buttonLabel.textContent = 'Отправляем...';

				document.getElementById('b24-form-popup-trigger-21')?.click();
				setFormStatus(form, 'success', 'Откроется форма Битрикс24. Заполните ее, чтобы отправить заявку.');
				if (buttonLabel instanceof HTMLElement) buttonLabel.textContent = originalLabel;
				updateSubmitState(form);
			});

			updateSubmitState(form);
		});
	};

	bindConsultationFormInputs();
	document.addEventListener('astro:page-load', bindConsultationFormInputs);
</script>

<style>
	[data-phone-digits],
	[data-phone-digits]:focus,
	[data-phone-digits]:focus-visible {
		border: 0 !important;
		border-radius: 0 !important;
		box-shadow: none !important;
		outline: none !important;
	}
</style>
