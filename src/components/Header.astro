---
interface Props {
	variant?: 'default' | 'glass';
}

const { variant = 'glass' } = Astro.props;
const isGlass = variant === 'glass';

const services = {
	'Разработка': [{ title: 'Сайты и\u00A0сервисы', href: '/services/web/' }],
	'Автоматизация': [
		{ title: 'Битрикс24', href: '/services/bitrix24/' },
		{ title: 'РосБизнесСофт', href: '/services/rbs/' },
		{ title: 'ЭЛМА', href: '/services/elma/' },
	],
	'Дополнительно': [
		{ title: 'Искусственный интеллект', href: '/services/ai/' },
		{ title: 'Сопровождение IT-проектов', href: '/services/support/' },
	],
};
---

<header
	class:list={[
		isGlass
			? 'sticky top-3 z-40 px-3 pt-3 sm:top-4 sm:px-6 sm:pt-4'
			: 'sticky top-0 z-40 border-b border-[color:var(--ds-border)] bg-white/88 backdrop-blur',
	]}
>
	<div
		class:list={[
			'relative mx-auto grid w-full max-w-[1440px] grid-cols-[minmax(0,1fr)_auto] items-center gap-4 overflow-visible md:grid-cols-[auto_minmax(0,1fr)_auto] md:gap-6',
			isGlass
				? 'rounded-[24px] border border-white/75 px-4 py-3 shadow-[0_18px_52px_rgba(17,17,17,0.13),inset_0_1px_0_rgba(255,255,255,0.95)] ring-1 ring-black/[0.04] sm:px-5'
				: 'px-6 py-4',
		]}
	>
		{isGlass && (
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-0 rounded-[24px] bg-white/78 backdrop-blur-2xl backdrop-saturate-150"
			></div>
		)}

		<a href="/" class="relative z-10 flex min-w-0 items-center gap-3 justify-self-start" aria-label="IT TIME NOW">
			<img
				src="/brand/ittn-logo.webp"
				alt="IT TIME NOW"
				class="h-[30px] w-auto shrink-0"
				loading="eager"
				decoding="async"
			/>
			<span class="hidden translate-y-px leading-tight text-[color:var(--ds-muted)] sm:block">
				<span class="block text-[11px] font-medium">Цифровые системы</span>
				<span class="block text-[11px] font-medium">эффективного бизнеса</span>
			</span>
		</a>

		<nav class="relative z-10 hidden items-center justify-self-center text-sm md:flex">
			<div class="group relative">
				<a
					href="/services/"
					class="flex items-center gap-1 rounded-full px-3 py-2 font-semibold text-[color:var(--ds-ink)] transition hover:bg-[rgba(35,43,255,0.06)] hover:text-[color:var(--ds-primary)] focus-visible:text-[color:var(--ds-primary)] group-hover:text-[color:var(--ds-primary)]"
					aria-haspopup="true"
				>
					Услуги
					<svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M2 4l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</a>
				<div
					class="invisible pointer-events-none absolute top-full left-1/2 z-50 w-[640px] max-w-[calc(100vw-2rem)] -translate-x-1/2 pt-3 group-hover:pointer-events-auto group-hover:visible group-focus-within:pointer-events-auto group-focus-within:visible"
				>
					<div
						class:list={[
							'relative overflow-hidden',
							isGlass
								? 'rounded-[24px] border border-white/75 bg-white/86 shadow-[0_24px_60px_rgba(17,17,17,0.16),inset_0_1px_0_rgba(255,255,255,0.95)] ring-1 ring-black/[0.04] backdrop-blur-[64px] backdrop-saturate-200'
								: 'rounded-[20px] border border-[color:var(--ds-border)] bg-white shadow-xl',
						]}
					>
						<div class="relative z-10 grid grid-cols-3 gap-6 p-6">
							{Object.entries(services).map(([group, items]) => (
								<div>
									<p class="mb-3 text-xs font-bold uppercase text-[color:var(--ds-muted)]">
										{group}
									</p>
									<ul class="space-y-2">
										{items.map((item) => (
											<li>
												<a
													href={item.href}
													class="block rounded-lg px-2 py-1 text-sm font-medium text-[color:var(--ds-ink)] transition hover:bg-[rgba(35,43,255,0.06)] hover:text-[color:var(--ds-primary)]"
												>
													{item.title}
												</a>
											</li>
										))}
									</ul>
								</div>
							))}
						</div>
					</div>
				</div>
			</div>

			<a href="/cases/" class="rounded-full px-3 py-2 font-semibold text-[color:var(--ds-ink)] transition hover:bg-[rgba(35,43,255,0.06)] hover:text-[color:var(--ds-primary)] focus-visible:text-[color:var(--ds-primary)]">
				Кейсы
			</a>
			<a href="/posts/" class="rounded-full px-3 py-2 font-semibold text-[color:var(--ds-ink)] transition hover:bg-[rgba(35,43,255,0.06)] hover:text-[color:var(--ds-primary)] focus-visible:text-[color:var(--ds-primary)]">
				Блог
			</a>
			<a href="/about/" class="rounded-full px-3 py-2 font-semibold text-[color:var(--ds-ink)] transition hover:bg-[rgba(35,43,255,0.06)] hover:text-[color:var(--ds-primary)] focus-visible:text-[color:var(--ds-primary)]">
				О&nbsp;нас
			</a>
		</nav>

		<div class="relative z-10 col-start-2 flex items-center gap-3 justify-self-end md:col-start-3">
			<a
				href="tel:+74951335888"
				class="hidden text-sm font-bold text-[color:var(--ds-ink)] transition hover:text-[color:var(--ds-primary)] lg:inline"
			>
				+7&nbsp;(495)&nbsp;133-58-88
			</a>
			<button
				id="mobile-menu-toggle"
				type="button"
				aria-label="Меню"
				class:list={[
					'inline-flex h-10 w-10 items-center justify-center text-[color:var(--ds-ink)] md:hidden',
					isGlass
						? 'rounded-2xl border border-white/70 bg-white/65 shadow-[inset_0_1px_0_rgba(255,255,255,0.9)] backdrop-blur-xl'
						: 'rounded-xl border border-[color:var(--ds-border)] bg-white',
				]}
			>
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M3 6h18M3 12h18M3 18h18"></path>
				</svg>
			</button>
		</div>
	</div>

	<div
		id="mobile-menu"
		class:list={[
			'hidden md:hidden',
			isGlass
				? 'mx-auto mt-2 w-full max-w-[1440px] rounded-[24px] border border-white/75 bg-white/90 px-4 py-4 shadow-[0_18px_50px_rgba(17,17,17,0.12),inset_0_1px_0_rgba(255,255,255,0.92)] backdrop-blur-2xl backdrop-saturate-150'
				: 'border-t border-[color:var(--ds-border)] bg-white px-6 py-4',
		]}
	>
		<nav class="flex flex-col gap-3 text-sm font-semibold text-[color:var(--ds-ink)]">
			<a href="/services/" class="font-medium">Услуги</a>
			{Object.entries(services).map(([group, items]) => (
				<div class="ml-3 border-l border-[color:var(--ds-border)] pl-3">
					<p class="text-xs font-bold uppercase text-[color:var(--ds-muted)]">{group}</p>
					<ul class="mt-1 space-y-1">
						{items.map((item) => (
							<li><a href={item.href} class="text-[color:var(--ds-muted)]">{item.title}</a></li>
						))}
					</ul>
				</div>
			))}
			<a href="/cases/">Кейсы</a>
			<a href="/posts/">Блог</a>
			<a href="/about/">О&nbsp;нас</a>
		</nav>
	</div>
</header>

<script>
	function bindMobileMenu() {
		const btn = document.getElementById('mobile-menu-toggle');
		const menu = document.getElementById('mobile-menu');
		if (!btn || !menu || btn.dataset.bound) return;
		btn.dataset.bound = '1';
		btn.addEventListener('click', () => menu.classList.toggle('hidden'));
	}
	bindMobileMenu();
	document.addEventListener('astro:page-load', bindMobileMenu);
</script>
