---
import UiIcon from './UiIcon.astro';
import { aiServiceGroup, serviceGroups, supportService } from '../data/service-navigation';

interface Props {
	variant?: 'default' | 'glass';
}

const { variant = 'glass' } = Astro.props;
const isGlass = variant === 'glass';
const normalizePath = (path: string) => path === '/' ? path : path.replace(/\/+$/, '');
const currentPath = normalizePath(Astro.url.pathname);
const isCurrent = (href: string) => normalizePath(href) === currentPath;

const desktopNavClass = 'rounded-full px-3 py-2 font-semibold';
const desktopNavLinkClass = `${desktopNavClass} text-[color:var(--ds-ink)] transition hover:bg-[rgba(35,43,255,0.06)] hover:text-[color:var(--ds-primary)] focus-visible:text-[color:var(--ds-primary)]`;
const desktopCurrentClass = `${desktopNavClass} cursor-default text-[color:var(--ds-primary)]`;
const dropdownLinkClass = 'block rounded-lg px-2 py-1 text-sm font-medium text-[color:var(--ds-ink)] transition hover:bg-[rgba(35,43,255,0.06)] hover:text-[color:var(--ds-primary)]';
const dropdownCurrentClass = 'block cursor-default rounded-lg px-2 py-1 text-sm font-semibold text-[color:var(--ds-primary)]';
const mobileCurrentClass = 'cursor-default text-[color:var(--ds-primary)]';

---

<header
	class:list={[
		isGlass
			? 'fixed inset-x-0 top-0 z-40 px-3 pt-3 sm:px-6 sm:pt-4'
			: 'fixed inset-x-0 top-0 z-40 border-b border-[color:var(--ds-border)] bg-white/88 backdrop-blur-md',
	]}
>
	<div
		class:list={[
			'relative mx-auto grid w-full max-w-[1440px] grid-cols-[minmax(0,1fr)_auto] items-center gap-4 overflow-visible md:grid-cols-[auto_minmax(0,1fr)_auto] md:gap-6',
			isGlass
				? 'rounded-[24px] border border-white/75 px-4 py-3 shadow-[0_18px_52px_rgba(17,17,17,0.13),inset_0_1px_0_rgba(255,255,255,0.95)] ring-1 ring-black/[0.04] sm:px-5'
				: 'px-6 py-4',
		]}
	>
		{isGlass && (
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-0 rounded-[24px] bg-white/78 backdrop-blur-md backdrop-saturate-125"
			></div>
		)}

		<a href="/" class="relative z-10 flex min-w-0 items-center gap-3 justify-self-start" aria-label="IT TIME NOW">
			<img
				src="/brand/ittn-logo.webp"
				alt="IT TIME NOW"
				class="h-[30px] w-auto shrink-0"
				loading="eager"
				decoding="async"
			/>
			<span class="hidden translate-y-px leading-tight text-[color:var(--ds-muted)] sm:block">
				<span class="block text-[11px] font-medium">Цифровые системы</span>
				<span class="block text-[11px] font-medium">эффективного бизнеса</span>
			</span>
		</a>

		<nav class="relative z-10 hidden items-center justify-self-center text-sm md:flex">
			<div class="group relative">
				{isCurrent('/services/') ? (
					<span
						class="flex cursor-default items-center gap-1 rounded-full px-3 py-2 font-semibold text-[color:var(--ds-primary)]"
						aria-current="page"
						aria-haspopup="true"
						tabindex="0"
					>
						Услуги
						<UiIcon name="nav-down-12" class="h-[21px] w-[21px]" />
					</span>
				) : (
					<a
						href="/services/"
						class="flex items-center gap-1 rounded-full px-3 py-2 font-semibold text-[color:var(--ds-ink)] transition hover:bg-[rgba(35,43,255,0.06)] hover:text-[color:var(--ds-primary)] focus-visible:text-[color:var(--ds-primary)] group-hover:text-[color:var(--ds-primary)]"
						aria-haspopup="true"
					>
						Услуги
						<UiIcon name="nav-down-12" class="h-[21px] w-[21px]" />
					</a>
				)}
				<div
					class="invisible pointer-events-none absolute top-full left-1/2 z-50 w-[700px] max-w-[calc(100vw-2rem)] -translate-x-1/2 pt-1 group-hover:pointer-events-auto group-hover:visible group-focus-within:pointer-events-auto group-focus-within:visible lg:-left-5 lg:translate-x-0"
				>
					<div
						class:list={[
							'relative overflow-hidden',
							isGlass
								? 'rounded-[24px] border border-white/75 bg-white/86 shadow-[0_24px_60px_rgba(17,17,17,0.16),inset_0_1px_0_rgba(255,255,255,0.95)] ring-1 ring-black/[0.04] backdrop-blur-md backdrop-saturate-125'
								: 'rounded-[20px] border border-[color:var(--ds-border)] bg-white shadow-xl',
						]}
					>
						<div class="relative z-10 grid grid-cols-3 gap-4 p-5">
							{serviceGroups.map((group) => (
								<div>
									<p class="mb-3 text-xs font-bold uppercase text-[color:var(--ds-muted)]">
										{group.title}
									</p>
									<ul class="space-y-2">
										{group.items.map((item) => (
											<li>
											{isCurrent(item.href) ? (
												<span class={dropdownCurrentClass} aria-current="page">{item.shortTitle}</span>
											) : (
												<a href={item.href} class={dropdownLinkClass}>{item.shortTitle}</a>
											)}
											</li>
										))}
									</ul>
								</div>
							))}
							<div>
								{isCurrent(aiServiceGroup.href) ? (
									<span class="mb-3 block cursor-default text-xs font-bold uppercase text-[color:var(--ds-primary)]" aria-current="page">
										{aiServiceGroup.title}
									</span>
								) : (
									<a href={aiServiceGroup.href} class="mb-3 block text-xs font-bold uppercase text-[color:var(--ds-primary)] hover:text-[color:var(--ds-ink)]">
										{aiServiceGroup.title}
									</a>
								)}
								<ul class="space-y-2">
									{aiServiceGroup.items.map((item) => (
										<li>
										{isCurrent(item.href) ? (
											<span class={dropdownCurrentClass} aria-current="page">{item.title}</span>
										) : (
											<a href={item.href} class={dropdownLinkClass}>{item.title}</a>
										)}
										</li>
									))}
								</ul>
							</div>
						</div>
						{isCurrent(supportService.href) ? (
							<div class="relative z-10 flex cursor-default items-center justify-between gap-4 border-t border-[color:var(--ds-border)] px-5 py-3 text-sm font-semibold text-[color:var(--ds-primary)]" aria-current="page">
								<span>{supportService.title}</span>
								<span class="font-normal text-[color:var(--ds-muted)]">{supportService.description}</span>
							</div>
						) : (
							<a
								href={supportService.href}
								class="relative z-10 flex items-center justify-between gap-4 border-t border-[color:var(--ds-border)] px-5 py-3 text-sm font-semibold text-[color:var(--ds-ink)] transition hover:bg-[rgba(35,43,255,0.05)] hover:text-[color:var(--ds-primary)]"
							>
								<span>{supportService.title}</span>
								<span class="font-normal text-[color:var(--ds-muted)]">{supportService.description}</span>
								<UiIcon name="arrow" class="h-[28px] w-[28px] shrink-0" />
							</a>
						)}
					</div>
				</div>
			</div>

			{[
				{ href: '/cases/', label: 'Кейсы' },
				{ href: '/posts/', label: 'Блог' },
				{ href: '/about/', label: 'О\u00a0нас' },
			].map((item) => isCurrent(item.href) ? (
				<span class={desktopCurrentClass} aria-current="page">{item.label}</span>
			) : (
				<a href={item.href} class={desktopNavLinkClass}>{item.label}</a>
			))}
		</nav>

		<div class="relative z-10 col-start-2 flex items-center gap-3 justify-self-end md:col-start-3">
			<button
				type="button"
				class="consultation-trigger hidden h-10 w-10 cursor-pointer items-center justify-center text-[color:var(--ds-primary)] transition hover:text-[color:var(--ds-ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--ds-primary)] lg:inline-flex"
				data-b24-form-trigger
				aria-label="Бесплатная консультация"
			>
				<UiIcon name="phone" class="h-[35px] w-[35px]" />
			</button>
			<button
				id="mobile-menu-toggle"
				type="button"
				aria-label="Открыть меню"
				aria-expanded="false"
				aria-controls="mobile-menu"
				class:list={[
					'inline-flex h-10 w-10 items-center justify-center text-[color:var(--ds-ink)] md:hidden',
					isGlass
						? 'rounded-2xl border border-white/70 bg-white/65 shadow-[inset_0_1px_0_rgba(255,255,255,0.9)] backdrop-blur-md'
						: 'rounded-xl border border-[color:var(--ds-border)] bg-white',
				]}
			>
				<UiIcon name="menu-24" class="h-[28px] w-[28px]" />
			</button>
		</div>
	</div>

	<div
		id="mobile-menu"
		hidden
		class:list={[
			'md:hidden',
			isGlass
				? 'mx-auto mt-2 w-full max-w-[1440px] rounded-[24px] border border-white/75 bg-white/90 px-4 py-4 shadow-[0_18px_50px_rgba(17,17,17,0.12),inset_0_1px_0_rgba(255,255,255,0.92)] backdrop-blur-md backdrop-saturate-125'
				: 'border-t border-[color:var(--ds-border)] bg-white px-6 py-4',
		]}
	>
		<nav class="flex flex-col gap-3 text-sm font-semibold text-[color:var(--ds-ink)]">
			{isCurrent('/services/') ? (
				<span class={`font-medium ${mobileCurrentClass}`} aria-current="page">Услуги</span>
			) : (
				<a href="/services/" class="font-medium">Услуги</a>
			)}
			{serviceGroups.map((group) => (
				<div class="ml-3 border-l border-[color:var(--ds-border)] pl-3">
					<p class="text-xs font-bold uppercase text-[color:var(--ds-muted)]">{group.title}</p>
					<ul class="mt-1 space-y-1">
						{group.items.map((item) => (
							<li>
								{isCurrent(item.href) ? (
									<span class={mobileCurrentClass} aria-current="page">{item.shortTitle}</span>
								) : (
									<a href={item.href} class="text-[color:var(--ds-muted)]">{item.shortTitle}</a>
								)}
							</li>
						))}
					</ul>
				</div>
			))}
			<div class="ml-3 border-l border-[color:var(--ds-border)] pl-3">
				{isCurrent(aiServiceGroup.href) ? (
					<span class="cursor-default text-xs font-bold uppercase text-[color:var(--ds-primary)]" aria-current="page">{aiServiceGroup.title}</span>
				) : (
					<a href={aiServiceGroup.href} class="text-xs font-bold uppercase text-[color:var(--ds-primary)]">{aiServiceGroup.title}</a>
				)}
				<ul class="mt-1 space-y-1">
					{aiServiceGroup.items.map((item) => (
						<li>
							{isCurrent(item.href) ? (
								<span class={mobileCurrentClass} aria-current="page">{item.title}</span>
							) : (
								<a href={item.href} class="text-[color:var(--ds-muted)]">{item.title}</a>
							)}
						</li>
					))}
				</ul>
			</div>
			{[
				{ href: supportService.href, label: supportService.title },
				{ href: '/cases/', label: 'Кейсы' },
				{ href: '/posts/', label: 'Блог' },
				{ href: '/about/', label: 'О\u00a0нас' },
			].map((item) => isCurrent(item.href) ? (
				<span class={mobileCurrentClass} aria-current="page">{item.label}</span>
			) : (
				<a href={item.href}>{item.label}</a>
			))}
		</nav>
	</div>
</header>

<style>
  #mobile-menu { max-height: calc(100dvh - 104px); overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
  #mobile-menu[hidden] { display: none; }
  #mobile-menu a { display: block; padding-block: 8px; }
</style>
<script>
  import { bindMobileMenu } from '../scripts/mobile-menu.js';
  bindMobileMenu();
  document.addEventListener('astro:page-load', () => bindMobileMenu());
</script>
