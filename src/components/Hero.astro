---
import ConsultationCta from './ConsultationCta.astro';

const metrics = [
	{ value: '150+', label: 'проектов' },
	{ value: '10+', label: 'лет на рынке' },
	{ value: 'CRM / ERP', label: 'интеграции и разработка' },
	{ value: 'Полный цикл', label: 'аудит → запуск → развитие' },
];

const segments = ['B2B', 'Производство', 'Опт', 'Сервис', 'Строительство'];
---

<section class="ds relative isolate overflow-hidden border-b border-neutral-200 bg-white dark:border-neutral-800">
	<div class="mx-auto max-w-[1440px] px-6 py-14 sm:py-20 lg:py-24">
		<h1 class="hero-lockup" aria-label="Делаем сложное ИТ — простым, а скучное — крутым!">
			<span class="hero-lockup__row hero-lockup__row--top" aria-hidden="true">
				<span class="hero-lockup__text">Делаем сложное</span>
				<img
					src="/ds-v2/assets/hero-word-it.png"
					alt=""
					class="hero-lockup__image hero-lockup__image--it"
					loading="eager"
					decoding="async"
				/>
			</span>
			<span class="hero-lockup__row hero-lockup__row--middle" aria-hidden="true">
				<span class="hero-lockup__text">—</span>
				<img
					src="/ds-v2/assets/hero-word-simple.png"
					alt=""
					class="hero-lockup__image hero-lockup__image--simple"
					loading="eager"
					decoding="async"
				/>
				<span class="hero-lockup__text">, а</span>
			</span>
			<span class="hero-lockup__row hero-lockup__row--bottom" aria-hidden="true">
				<span class="hero-lockup__text">скучное —</span>
				<img
					src="/ds-v2/assets/hero-word-cool.png"
					alt=""
					class="hero-lockup__image hero-lockup__image--cool"
					loading="eager"
					decoding="async"
				/>
			</span>
		</h1>

		<p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-700 sm:text-xl dark:text-neutral-300">
			Проектируем и внедряем цифровые решения, которые объединяют сайт,
			продажи, документы, склад, производство и сервис в один управляемый контур.
		</p>

		<ConsultationCta />

		<div class="mt-8 flex flex-wrap gap-2">
			{segments.map((segment) => (
				<span class="rounded-full border border-neutral-200 bg-white/62 px-3 py-1 text-sm text-neutral-700 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/54 dark:text-neutral-300">
					{segment}
				</span>
			))}
		</div>

		<dl class="mt-10 grid max-w-4xl grid-cols-2 gap-x-6 gap-y-5 border-t border-neutral-200 pt-6 sm:grid-cols-4 dark:border-neutral-800">
			{metrics.map((metric) => (
				<div>
					<dt class="text-sm leading-5 text-neutral-600 dark:text-neutral-400">{metric.label}</dt>
					<dd class="mt-1 text-xl font-semibold text-neutral-950 dark:text-white">{metric.value}</dd>
				</div>
			))}
		</dl>
	</div>
</section>

<style>
	.hero-lockup {
		display: grid;
		width: min(100%, 820px);
		margin: 0;
		color: #111111;
		font-size: 34px;
		font-weight: 400;
		line-height: 0.92;
	}

	.hero-lockup__row {
		display: flex;
		min-width: 0;
		align-items: center;
	}

	.hero-lockup__row--top {
		gap: 0.35em;
	}

	.hero-lockup__row--middle {
		margin-top: -0.04em;
		gap: 0.22em;
	}

	.hero-lockup__row--bottom {
		margin-top: -0.08em;
		gap: 0.3em;
	}

	.hero-lockup__text {
		display: block;
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.hero-lockup__image {
		display: block;
		flex: none;
		height: auto;
		object-fit: contain;
	}

	.hero-lockup__image--it {
		width: 1.75em;
	}

	.hero-lockup__image--simple {
		width: min(5.35em, 100%);
	}

	.hero-lockup__image--cool {
		width: min(4.8em, 52%);
	}

	@media (min-width: 640px) {
		.hero-lockup {
			font-size: 52px;
		}
	}

	@media (min-width: 1024px) {
		.hero-lockup {
			font-size: 68px;
		}
	}

	@media (max-width: 520px) {
		.hero-lockup__row--top,
		.hero-lockup__row--middle,
		.hero-lockup__row--bottom {
			flex-wrap: wrap;
			justify-content: flex-start;
		}

		.hero-lockup__image--cool {
			width: min(4.8em, 100%);
		}
	}
</style>
