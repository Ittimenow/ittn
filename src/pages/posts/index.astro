---
import ServiceCta from '../../components/ServiceCta.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Блог — ittimenow" description="Заметки команды ittimenow о разработке, ИИ и автоматизации.">
	<section class="mx-auto max-w-4xl px-6 py-16 sm:py-24">
		<div>

			<Breadcrumbs current="Блог" />
<h1 class="ds-page-title mt-2">Блог</h1>
			<p class="mt-4 max-w-2xl text-lg text-neutral-600 dark:text-neutral-400">
				Заметки о разработке, внедрениях и ИИ в боевых проектах.
			</p>
		</div>

		<div class="mt-12">
			{posts.length === 0 ? (
				<p class="rounded-xl border border-dashed border-neutral-300 p-10 text-center text-neutral-500 dark:border-neutral-800">
					Готовим новые материалы о разработке и автоматизации.
				</p>
			) : (
				<ul class="catalog-card-list service-card-row grid gap-10" data-progressive-list>
					{posts.map((post) => (
						<li class="rounded-2xl border border-neutral-200 p-5">
							<a
								href={`/posts/${post.id}/`}
								class="group block"
							>
								{post.data.cover && (
									<img
										src={post.data.cover}
										alt={post.data.title}
										loading="lazy"
										class="aspect-[16/9] w-full rounded-lg object-cover"
									/>
								)}
								<h2
									class="post-card-title mt-5 max-w-4xl transition group-hover:text-[#323bff] dark:group-hover:text-[#323bff]"
									transition:name={`post-${post.id}`}
								>
									{post.data.title}
								</h2>
							</a>
						</li>
					))}
				</ul>
			)}
			<button type="button" class="catalog-load-more" data-load-more hidden>Показать ещё статьи</button>
		</div>
	</section>
<ServiceCta title="Хотите применить эти решения в своём бизнесе?" text="Разберём ваш процесс и подскажем, с чего начать автоматизацию или разработку." />
</Layout>

<script>
	import '../../scripts/progressive-list';
</script>

<style>
	.post-card-title {
		font-size: clamp(20px, 2vw, 26px);
		font-weight: 600;
		line-height: 1.25;
	}
</style>
