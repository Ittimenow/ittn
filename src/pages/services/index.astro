---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCta from '../../components/ServiceCta.astro';
import Layout from '../../layouts/Layout.astro';
import UiIcon from '../../components/UiIcon.astro';
import { serviceGroups } from '../../data/service-navigation';
import { aiServices } from '../../data/ai-services';

const groupIcons = ['layers', 'workflow'] as const;
const supportAreas = ['Сайты', 'CRM', 'ERP', 'Интеграции'];
const serviceList = [
	...serviceGroups.flatMap<{ title: string; href: string }>((group) => group.items),
	{ title: 'ИИ для бизнеса', href: '/services/ai/' },
	...aiServices.map((service) => ({ title: service.cardTitle, href: `/services/ai/${service.slug}/` })),
	{ title: 'Техническая поддержка', href: '/services/support/' },
];
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Услуги IT TIME NOW',
	itemListElement: serviceList.map((service, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: service.title,
		url: new URL(service.href, Astro.site ?? Astro.url).href,
	})),
};
---

<Layout
	title="Услуги IT TIME NOW — разработка, автоматизация и ИИ для бизнеса"
	description="Разрабатываем сайты и веб-сервисы, внедряем CRM и ERP, интегрируем системы, создаём ИИ-решения и поддерживаем цифровые проекты."
	structuredData={structuredData}
>
	<section class="services-hero">
		<div class="services-shell">
			<Breadcrumbs current="Услуги" />
<h1>Разрабатываем цифровые продукты, автоматизируем процессы и&nbsp;внедряем ИИ</h1>
			<p class="services-hero-copy">Подбираем решение под задачу бизнеса: создаём новый продукт, связываем существующие системы или развиваем работающий цифровой контур.</p>
			<a class="services-scroll-link" href="#service-map"><span>Выбрать направление</span><UiIcon name="arrow" class="h-[28px] w-[28px]" /></a>
		</div>
	</section>

	<section id="service-map" class="services-section">
		<div class="services-shell">
			<div class="services-heading">
				<h2>Создаём с нуля или наводим порядок в существующей системе</h2>
			</div>
			<div class="services-groups service-card-row">
				{serviceGroups.map((group, groupIndex) => (
					<article class="service-group">
						<div class="service-group-heading">
							<span class="service-group-icon"><UiIcon name={groupIcons[groupIndex]} class="h-[42px] w-[42px]" /></span>
							<div><h3>{group.title}</h3><p>{group.description}</p></div>
						</div>
						<div class="service-group-list">
							{group.items.map((item) => (
								<a class="service-row" href={item.href}>
									<span><strong>{item.title}</strong><small>{item.description}</small></span>
									<UiIcon name="arrow" class="h-[35px] w-[35px]" />
								</a>
							))}
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="services-section services-section-ai">
		<div class="services-shell">
			<div class="ai-feature">
				<div class="ai-feature-copy">
					<div class="ai-feature-labels"><span>Популярное</span></div>
					<h2><a href="/services/ai/">ИИ для бизнеса</a></h2>
					<p>Встраиваем искусственный интеллект в реальные процессы компании — от первого сценария до интеграции с вашими данными и системами.</p>
				</div>
				<ul class="ai-capabilities service-card-row" aria-label="Возможности ИИ-решений">
					{aiServices.map((service) => (
						<li><a href={`/services/ai/${service.slug}/`}><UiIcon name={service.icon} class="h-[35px] w-[35px]" /><span>{service.cardTitle}</span><UiIcon name="arrow" class="h-[28px] w-[28px]" /></a></li>
					))}
				</ul>
				<a class="ai-feature-link" href="/services/ai/">Смотреть все ИИ-решения <UiIcon name="arrow" class="h-[35px] w-[35px]" /></a>
				<span class="ai-orbit ai-orbit-one" aria-hidden="true"></span><span class="ai-orbit ai-orbit-two" aria-hidden="true"></span>
			</div>
		</div>
	</section>

	<section class="services-section support-section">
		<div class="services-shell">
			<div class="support-card">
				<div class="support-card-copy">
					<h2>Техническая поддержка</h2>
					<p>Берём на себя стабильность, доработки и развитие цифрового проекта — независимо от того, создавали его мы или другая команда.</p>
					<a class="support-link" href="/services/support/">Подробнее о поддержке <UiIcon name="arrow" class="h-[35px] w-[35px]" /></a>
				</div>
				<ul class="support-areas" aria-label="Что поддерживаем">
					{supportAreas.map((area) => <li><UiIcon name="check" class="h-[35px] w-[35px]" /><span>{area}</span></li>)}
				</ul>
			</div>
		</div>
	</section>

	<ServiceCta title="Подберём решение под вашу задачу" text="Разберём текущую ситуацию, определим ближайший полезный шаг и предложим подходящий формат работы." />
</Layout>

<style>
	.services-shell { width: min(100% - 48px, 1240px); margin-inline: auto; }
	.services-hero { padding: 82px 0 96px; }
	.services-hero h1 { max-width: 1120px; margin: 20px 0 0; font-size: clamp(48px, 7.2vw, 92px); }
	.services-hero-copy { max-width: 760px; margin: 32px 0 0; color: var(--ds-muted); font-size: clamp(18px, 2vw, 23px); line-height: 1.55; }
	.services-scroll-link, .support-link { display: inline-flex; align-items: center; gap: 10px; margin-top: 32px; color: var(--ds-primary); font-size: 15px; font-weight: 800; text-decoration: none; }
	.services-scroll-link :global(.ui-icon), .support-link :global(.ui-icon) { transition: transform 180ms ease; }
	.services-scroll-link:hover :global(.ui-icon), .support-link:hover :global(.ui-icon) { transform: translateX(5px); }
	.services-section { padding: 72px 0; }
	.services-heading { max-width: 820px; margin-bottom: 36px; }
	.services-heading h2 { margin: 16px 0 0; }
	.services-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
	.service-group { overflow: hidden; border: 1px solid var(--ds-border); border-radius: 32px; background: rgba(255,255,255,.86); box-shadow: var(--ittn-shadow-soft); }
	.service-group-heading { display: flex; gap: 18px; padding: 30px 30px 26px; }
	.service-group-heading h3 { margin: 0; font-size: clamp(27px, 3vw, 36px); }
	.service-group-heading p { margin: 10px 0 0; color: var(--ds-muted); font-size: 16px; line-height: 1.55; }
	.service-group-icon { display: grid; width: 48px; height: 48px; flex: 0 0 auto; place-items: center; color: var(--ds-primary); }
	.service-group-list { border-top: 1px solid var(--ds-border); }
	.service-row { display: flex; min-height: 116px; align-items: center; justify-content: space-between; gap: 24px; padding: 22px 30px; text-decoration: none; transition: background 180ms ease, color 180ms ease; }
	.service-row + .service-row { border-top: 1px solid var(--ds-border); }
	.service-row strong, .service-row small { display: block; }
	.service-row strong { font-size: 19px; }
	.service-row small { max-width: 430px; margin-top: 6px; color: var(--ds-muted); font-size: 14px; line-height: 1.45; }
	.service-row > :global(.ui-icon) { flex: 0 0 auto; color: var(--ds-primary); transition: transform 180ms ease; }
	.service-row:hover { background: rgba(35,43,255,.045); color: var(--ds-primary); }
	.service-row:hover > :global(.ui-icon) { transform: translateX(5px); }
	.services-section-ai { padding-top: 48px; }
	.ai-feature { position: relative; isolation: isolate; display: grid; min-height: 500px; grid-template-columns: minmax(0, 1.1fr) minmax(300px, .9fr); grid-template-rows: 1fr auto; gap: 38px 64px; overflow: hidden; border-radius: 36px; background: var(--ds-primary); padding: clamp(32px, 5vw, 64px); color: #fff; box-shadow: var(--ds-glow); }
	.ai-feature-copy, .ai-capabilities, .ai-feature-link { position: relative; z-index: 2; }
	.ai-feature .ds-kicker, .ai-feature h2 { color: #fff; }
	.ai-feature h2 { margin: 22px 0 0; font-size: clamp(48px, 7vw, 82px); }
	.ai-feature h2 a { text-decoration: none; }
	.ai-feature-copy > p:last-child { max-width: 690px; margin: 24px 0 0; color: rgba(255,255,255,.78); font-size: 19px; line-height: 1.6; }
	.ai-feature-labels { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
	.ai-feature-labels > span { border-radius: 999px; background: var(--ittn-acid); padding: 7px 12px; color: var(--ittn-ink); font-family: var(--ittn-font-mono); font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
	.ai-capabilities { display: grid; align-self: center; gap: 12px; margin: 0; padding: 0; list-style: none; }
	.ai-capabilities li { border: 1px solid rgba(255,255,255,.22); border-radius: 16px; background: rgba(255,255,255,.09); backdrop-filter: blur(8px); }
	.ai-capabilities a { display: flex; align-items: center; gap: 12px; padding: 15px 17px; font-size: 16px; font-weight: 700; text-decoration: none; }
	.ai-capabilities a :global(.ui-icon:first-child) { color: var(--ittn-acid); }
	.ai-capabilities a :global(.ui-icon:last-child) { margin-left: auto; transition: transform 180ms ease; }
	.ai-capabilities a:hover :global(.ui-icon:last-child) { transform: translateX(5px); }
	.ai-feature-link { display: inline-flex; align-items: center; gap: 10px; align-self: end; color: #fff; font-weight: 800; text-decoration: none; }
	.ai-feature-link :global(.ui-icon) { transition: transform 180ms ease; }
	.ai-feature:hover .ai-feature-link :global(.ui-icon) { transform: translateX(6px); }
	.ai-orbit { position: absolute; z-index: 0; border: 1px solid rgba(255,255,255,.16); border-radius: 999px; pointer-events: none; }
	.ai-orbit-one { right: -140px; bottom: -240px; width: 620px; height: 620px; }
	.ai-orbit-two { right: 110px; bottom: -120px; width: 360px; height: 360px; }
	.support-section { padding-top: 48px; }
	.support-card { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr); align-items: center; gap: 48px; border: 1px solid var(--ds-border); border-radius: 32px; background: var(--ittn-cloud); padding: clamp(30px, 5vw, 56px); }
	.support-card-copy h2 { margin: 16px 0 0; }
	.support-card-copy > p:last-of-type { max-width: 720px; margin: 20px 0 0; color: var(--ds-muted); font-size: 18px; line-height: 1.6; }
	.support-areas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }
	.support-areas li { display: flex; align-items: center; gap: 10px; border-radius: 14px; background: #fff; padding: 16px; font-size: 15px; font-weight: 700; box-shadow: var(--ittn-shadow-soft); }
	.support-areas :global(.ui-icon) { color: var(--ds-primary); }
	.services-cta-section { padding: 72px 0 120px; }
	.services-cta { display: flex; align-items: flex-end; justify-content: space-between; gap: 48px; border-radius: 32px; background: var(--ittn-ink); padding: clamp(30px, 5vw, 56px); color: #fff; }
	.services-cta .ds-kicker, .services-cta h2 { color: #fff; }
	.services-cta h2 { max-width: 720px; margin: 16px 0 0; }
	.services-cta > div:first-child > p:last-child { max-width: 720px; margin: 20px 0 0; color: rgba(255,255,255,.65); font-size: 17px; line-height: 1.6; }
	.services-cta :global(.consultation-cta) { flex: 0 0 auto; margin-top: 0; }
	.services-cta :global(.consultation-free-label) { color: var(--ittn-acid); }
	@media (max-width: 900px) {
		.services-groups, .ai-feature, .support-card { grid-template-columns: 1fr; }
		.ai-feature { min-height: auto; }
		.services-cta { align-items: flex-start; flex-direction: column; }
	}
	@media (max-width: 640px) {
		.services-shell { width: min(100% - 32px, 1240px); }
		.services-hero { padding: 56px 0 64px; }
		.services-hero h1 { font-size: clamp(42px, 13vw, 58px); }
		.services-section { padding: 48px 0; }
		.service-group, .support-card, .services-cta { border-radius: 24px; }
		.service-group-heading { padding: 24px 20px 20px; }
		.service-group-icon { display: none; }
		.service-row { min-height: 104px; padding: 19px 20px; }
		.ai-feature { gap: 30px; border-radius: 24px; padding: 28px 22px; }
		.ai-feature h2 { font-size: 48px; }
		.ai-feature-copy > p:last-child { font-size: 17px; }
		.support-areas { grid-template-columns: 1fr; }
		.services-cta-section { padding: 48px 0 80px; }
		.services-cta :global(.consultation-cta), .services-cta :global(.ds-btn) { width: 100%; }
		.services-cta :global(.consultation-free-label) { margin-inline: auto; }
	}
</style>
