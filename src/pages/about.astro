---
import ServiceCta from '../components/ServiceCta.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Layout from '../layouts/Layout.astro';

const directions = [
	{
		title: 'Автоматизируем бизнес-процессы сокращая расходы предпринимателей',
		description:
			'Мы анализируем ваши бизнес-процессы, подбираем подходящие решения, интегрируем их с существующими системами, настраиваем под ваши нужды и обучаем персонал, обеспечивая повышение эффективности и улучшение взаимодействия с клиентами.',
	},
	{
		title: 'Создаём цифровые продукты и сервисы от идеи на салфетке до работающей системы',
		description:
			'Создаем адаптивные и функциональные веб-ресурсы, начиная с анализа ниши, заканчивая дизайном, разработкой, тестированием и запуском, а также обеспечиваем SEO-оптимизацию и техническую поддержку для привлечения и удержания клиентов.',
	},
	{
		title: 'Создаем уникальные запоминающиеся образы',
		description:
			'Разрабатываем уникальные логотипы, фирменный стиль и рекламные материалы, создаем брендбук и визуальный контент, проводим анализ рынка и конкурентов, чтобы создать запоминающийся и эффективный образ вашего бренда.',
	},
	{
		title: 'Поддерживаем и развиваем проекты',
		description:
			'Обеспечиваем мониторинг и профилактику систем, быстрое решение инцидентов, консультации и обучение сотрудников.',
	},
];

const team = [
	{
		name: 'Максим',
		position: 'Руководитель проектов',
		description: 'Управление проектами, продуктолог, маркетинг, брендинг, дизайн',
		image: '/about/max.webp',
		x: 15,
		y: 24,
		size: 210,
		cardSize: 330,
	},
	{
		name: 'Олег',
		position: 'Специалист внедрения',
		description: 'Внедрение CRM | ERP систем',
		image: '/about/oleg.webp',
		x: 37,
		y: 39,
		size: 160,
		cardSize: 310,
	},
	{
		name: 'Серж Ч',
		position: 'Fullstack разработчик Senior',
		description:
			'PHP, ASP, MySQL, NoSQL, MongoDB, Java ( J6, пока ограниченно), JS (ES6-7, jQuery), HTML5, CSS3, С#, C++, Python, VB',
		image: '/about/serg.webp',
		x: 61,
		y: 23,
		size: 190,
		cardSize: 340,
	},
	{
		name: 'Ярослав',
		position: 'Front-end разработчик',
		description: 'HTML, CSS, SCSS, JavaScript, React, Redux Toolkit, Three.js, node.js, gulp.js',
		image: '/about/yaroslav.webp',
		x: 85,
		y: 36,
		size: 220,
		cardSize: 330,
	},
	{
		name: 'Антон',
		position: '1С Разработчик',
		description: 'Ручное тестирование, автотесты, проектная документация, баг-фиксы',
		image: '/about/anton.webp',
		x: 15,
		y: 74,
		size: 170,
		cardSize: 310,
	},
	{
		name: 'Даниил',
		position: 'UX-UI дизайнер',
		description: 'Прототипы, интерфейсы, веб-дизайн',
		image: '/about/daniil.webp',
		x: 39,
		y: 68,
		size: 220,
		cardSize: 310,
	},
	{
		name: 'Артём',
		position: 'Графический дизайнер',
		description: 'Айдентика, шрифты, презентации',
		image: '/about/artem.webp',
		x: 63,
		y: 79,
		size: 180,
		cardSize: 310,
	},
	{
		name: 'Стас',
		position: 'Seo-специалист',
		description:
			'Создание прототипов, аналитика конкурентов, настройка и подготовка бизнеса к выходу в онлайн, SEO, контекст',
		image: '/about/stas.webp',
		x: 84,
		y: 68,
		size: 200,
		cardSize: 340,
	},
];

const description =
	'IT TIME NOW — команда экспертов по разработке сайтов, внедрению CRM и автоматизации бизнес-процессов. Работаем на результат.';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	name: 'О нас',
	description,
	inLanguage: 'ru-RU',
};
---

<Layout
	title="О компании IT TIME NOW — разработка и автоматизация - IT TIME NOW"
	description={description}
	image="/about/og.webp"
	structuredData={structuredData}
>
	<div class="about-page">
		<section class="about-hero" aria-labelledby="about-title">
			<div class="about-container">
				<Breadcrumbs current="О нас" />
<h1 id="about-title" class="about-hero__title">О нас</h1>
			</div>
		</section>

		<section class="about-directions" aria-label="Направления работы">
			<div class="about-container"><div class="about-directions__grid service-card-row">
				{directions.map((direction, index) => (
					<article class:list={['about-direction', `about-direction--${index + 1}`]}>
						<div class="about-direction__top" aria-hidden="true">

							<img src="/about/services-mark.webp" alt="" width="300" height="300" loading="lazy" decoding="async" />
						</div>
						<h2>{direction.title}</h2>
						<p>{direction.description}</p>
					</article>
				))}
			</div>
			</div>
		</section>

		<section class="about-team" aria-labelledby="team-title">
			<div class="about-container">
				<h2 id="team-title" class="about-team__title">Мы</h2>

				<div class="about-team__stage service-card-row" role="list">
					{team.map((member) => (
						<div
							class="about-person-slot"
							role="listitem"
							style={`--person-x: ${member.x}%; --person-y: ${member.y}%; --avatar-size: ${member.size}px; --card-size: ${member.cardSize}px;`}
						>
							<button
								type="button"
								class="about-person"
								data-team-card
								aria-expanded="false"
							>
								<span class="about-person__portrait">
									<img
										src={member.image}
										alt={member.name}
										width="600"
										height="600"
										loading="lazy"
										decoding="async"
									/>
								</span>
								<span class="about-person__content">
									<span class="about-person__name">{member.name}</span>
									<span class="about-person__position">{member.position}</span>
									<span class="about-person__description">{member.description}</span>
								</span>
							</button>
						</div>
					))}
				</div>
			</div>
		</section>
	</div>
<ServiceCta title="Обсудим ваш проект с командой IT TIME NOW?" text="Расскажите о задаче. Подберём специалистов, определим ближайший полезный результат и предложим формат работы." />
</Layout>

<script>
	function bindTeamCards() {
		const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-team-card]'));
		const hasHover = window.matchMedia('(hover: hover)').matches;

		cards.forEach((card) => {
			if (card.dataset.bound) return;
			card.dataset.bound = 'true';

			card.addEventListener('click', () => {
				if (hasHover) return;

				const shouldOpen = card.getAttribute('aria-expanded') !== 'true';
				cards.forEach((item) => item.setAttribute('aria-expanded', 'false'));
				card.setAttribute('aria-expanded', String(shouldOpen));
			});

			card.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape') return;
				card.setAttribute('aria-expanded', 'false');
				card.blur();
			});
		});
	}

	bindTeamCards();
	document.addEventListener('astro:page-load', bindTeamCards);
</script>

<style>
	.about-page {
		overflow: hidden;
		background: var(--ds-bg);
	}

	.about-container {
		width: min(100% - 48px, 1392px);
		margin-inline: auto;
	}

	.about-hero {
		padding: clamp(72px, 10vw, 144px) 0 clamp(52px, 7vw, 96px);
		border-bottom: 1px solid var(--ds-border);
		background: #ffffff;
	}

	.about-hero__title {
		margin: 0;
		font-size: clamp(64px, 10vw, 144px);
		font-weight: 800;
		line-height: 0.86;
		letter-spacing: -0.055em;
	}

	.about-directions {
		padding: 22px 0 clamp(72px, 10vw, 148px);
	}

	.about-directions__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}

	.about-direction {
		display: flex;
		min-height: 420px;
		flex-direction: column;
		border: 1px solid var(--ds-border);
		border-radius: var(--ittn-radius-lg);
		padding: clamp(24px, 3.25vw, 48px);
		background: #ffffff;
		box-shadow: var(--ittn-shadow-soft);
	}

	.about-direction__top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: auto;
	}

	.about-direction__top span {
		font-family: var(--ittn-font-mono);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.14em;
	}

	.about-direction__top img {
		width: 72px;
		height: 72px;
		object-fit: contain;
	}

	.about-direction h2 {
		max-width: 680px;
		margin: 64px 0 0;
		font-size: clamp(28px, 3vw, 44px);
		line-height: 1.03;
		letter-spacing: -0.025em;
	}

	.about-direction p {
		max-width: 680px;
		margin: 22px 0 0;
		font-size: 16px;
		line-height: 1.65;
	}

	.about-direction--1 {
		border-color: transparent;
		background: var(--ittn-blue);
		color: #ffffff;
	}

	.about-direction--1 h2 {
		color: #ffffff;
	}

	.about-direction--1 .about-direction__top img,
	.about-direction--4 .about-direction__top img {
		filter: invert(1);
	}

	.about-direction--2 {
		border-color: transparent;
		background: var(--ittn-acid);
	}

	.about-direction--3 {
		background:
			linear-gradient(135deg, rgba(35, 43, 255, 0.08), transparent 48%),
			#ffffff;
	}

	.about-direction--4 {
		border-color: transparent;
		background: var(--ittn-ink);
		color: #ffffff;
	}

	.about-direction--4 h2 {
		color: #ffffff;
	}

	.about-team {
		overflow: clip;
		padding: clamp(72px, 9vw, 136px) 0 clamp(88px, 11vw, 160px);
		background: #ffffff;
	}

	.about-team .about-container {
		width: min(100% - 96px, 1440px);
	}

	.about-team__title {
		margin: 0 0 clamp(20px, 3vw, 44px);
		font-size: clamp(72px, 13vw, 176px);
		font-weight: 800;
		line-height: 0.8;
		letter-spacing: -0.06em;
	}

	.about-team__stage {
		position: relative;
		height: 840px;
		isolation: isolate;
	}

	.about-person-slot {
		position: absolute;
		top: var(--person-y);
		left: var(--person-x);
		z-index: 1;
		width: 0;
		height: 0;
	}

	.about-person-slot:is(:hover, :focus-within),
	.about-person-slot:has(.about-person[aria-expanded='true']) {
		z-index: 20;
	}

	.about-person {
		position: absolute;
		top: 0;
		left: 0;
		display: block;
		width: var(--avatar-size);
		height: var(--avatar-size);
		overflow: hidden;
		padding: 0;
		transform: translate(-50%, -50%);
		border: 0;
		border-radius: 50%;
		background: #ffffff;
		color: var(--ds-ink);
		text-align: center;
		cursor: pointer;
		isolation: isolate;
		transition:
			width 560ms cubic-bezier(0.16, 1, 0.3, 1),
			height 560ms cubic-bezier(0.16, 1, 0.3, 1),
			border-radius 560ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.about-person-slot:is(:hover, :focus-within) .about-person,
	.about-person[aria-expanded='true'] {
		width: var(--card-size);
		height: var(--card-size);
		border-radius: 28px;
	}

	.about-person__portrait,
	.about-person__content {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.about-person__portrait {
		filter: blur(0);
		opacity: 1;
		transition:
			filter 520ms cubic-bezier(0.16, 1, 0.3, 1),
			opacity 320ms ease;
	}

	.about-person__portrait img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.about-person__content {
		flex-direction: column;
		padding: clamp(22px, 2.5vw, 34px);
		filter: blur(16px);
		opacity: 0;
		transition:
			filter 520ms cubic-bezier(0.16, 1, 0.3, 1),
			opacity 320ms ease 70ms;
	}

	.about-person-slot:is(:hover, :focus-within) .about-person__portrait,
	.about-person[aria-expanded='true'] .about-person__portrait {
		filter: blur(18px);
		opacity: 0;
	}

	.about-person-slot:is(:hover, :focus-within) .about-person__content,
	.about-person[aria-expanded='true'] .about-person__content {
		filter: blur(0);
		opacity: 1;
	}

	.about-person__name,
	.about-person__position,
	.about-person__description {
		display: block;
		width: 100%;
		text-align: center;
	}

	.about-person__name {
		font-size: clamp(28px, 2.4vw, 36px);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.025em;
	}

	.about-person__position {
		margin-top: 12px;
		color: var(--ittn-blue);
		font-size: 13px;
		font-weight: 700;
		line-height: 1.4;
	}

	.about-person__description {
		margin-top: 22px;
		color: var(--ds-muted);
		font-size: clamp(12px, 1.05vw, 14px);
		line-height: 1.5;
	}

	@media (max-width: 1100px) {
		.about-direction {
			min-height: 390px;
		}

		.about-team .about-container {
			width: min(100% - 48px, 1440px);
		}

		.about-team__stage {
			display: grid;
			height: auto;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 28px 12px;
			padding-bottom: 44px;
		}

		.about-person-slot {
			position: relative;
			top: auto;
			left: auto;
			display: grid;
			width: 100%;
			height: 320px;
			place-items: center;
		}

		.about-person-slot:nth-child(3n + 2) {
			transform: translateY(44px);
		}

		.about-person {
			position: relative;
			top: auto;
			left: auto;
			width: min(var(--avatar-size), 190px);
			height: min(var(--avatar-size), 190px);
			transform: none;
		}

		.about-person-slot:is(:hover, :focus-within) .about-person,
		.about-person[aria-expanded='true'] {
			width: min(var(--card-size), 300px);
			height: min(var(--card-size), 300px);
		}
	}

	@media (max-width: 820px) {
		.about-team__stage {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.about-person-slot,
		.about-person-slot:nth-child(3n + 2) {
			height: 310px;
			transform: none;
		}

		.about-person-slot:nth-child(even) {
			transform: translateY(34px);
		}
	}

	@media (max-width: 720px) {
		.about-container {
			width: min(100% - 32px, 1392px);
		}

		.about-hero {
			padding: 64px 0 52px;
		}

		.about-hero__title {
			font-size: clamp(64px, 22vw, 104px);
		}

		.about-directions__grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.about-direction {
			min-height: 360px;
			padding: 24px;
		}

		.about-direction h2 {
			margin-top: 54px;
			font-size: clamp(28px, 8.5vw, 38px);
		}

		.about-direction p {
			font-size: 15px;
		}

		.about-team__title {
			font-size: clamp(72px, 26vw, 112px);
		}

		.about-team .about-container {
			width: min(100% - 32px, 1440px);
		}
	}

	@media (max-width: 620px) {
		.about-team__stage {
			grid-template-columns: minmax(0, 1fr);
			gap: 8px;
		}

		.about-person-slot,
		.about-person-slot:nth-child(3n + 2),
		.about-person-slot:nth-child(even) {
			height: 274px;
			transform: translateX(-7%);
		}

		.about-person-slot:nth-child(even) {
			transform: translateX(7%);
		}

		.about-person {
			width: min(var(--avatar-size), 170px);
			height: min(var(--avatar-size), 170px);
		}

		.about-person-slot:is(:hover, :focus-within) .about-person,
		.about-person[aria-expanded='true'] {
			width: min(var(--card-size), calc(100vw - 64px), 300px);
			height: min(var(--card-size), calc(100vw - 64px), 300px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-person,
		.about-person__portrait,
		.about-person__content {
			transition: none;
		}
	}

  @media (max-width: 767px) {
    .about-team .about-container { width: calc(100% - 48px); }
    .about-team__stage { gap: 20px; height: auto; }
    .about-team__stage > .about-person-slot { height: 310px; border-radius: 28px; border: 1px solid var(--ds-primary); }
    .about-person, .about-person-slot:is(:hover, :focus-within) .about-person, .about-person[aria-expanded='true'] { width: 100%; height: 100%; border-radius: 28px; }
  }
</style>

<style is:global>
	main:has(> .about-page) + footer {
		margin-top: 0;
	}

  @media (max-width: 767px) {
    .about-team .about-container { width: calc(100% - 48px); }
    .about-team__stage { gap: 20px; height: auto; }
    .about-team__stage > .about-person-slot { height: 310px; border-radius: 28px; border: 1px solid var(--ds-primary); }
    .about-person, .about-person-slot:is(:hover, :focus-within) .about-person, .about-person[aria-expanded='true'] { width: 100%; height: 100%; border-radius: 28px; }
  }
</style>
