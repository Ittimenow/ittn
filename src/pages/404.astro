---
import ServiceCta from '../components/ServiceCta.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import UiIcon from '../components/UiIcon.astro';
import Layout from '../layouts/Layout.astro';

Astro.response.status = 404;

const quickLinks = [
	{
		title: 'Услуги',
		description: 'Разработка, CRM/ERP, BPM, ИИ и сопровождение IT-проектов.',
		href: '/services',
	},
	{
		title: 'Кейсы',
		description: 'Примеры внедрений, сайтов и цифровых продуктов для бизнеса.',
		href: '/cases',
	},
	{
		title: 'Блог',
		description: 'Материалы про автоматизацию, CRM и управление разработкой.',
		href: '/posts',
	},
];
---

<Layout
	title="Страница не найдена — IT TIME NOW"
	description="Страница не найдена. Вернитесь на главную IT TIME NOW или выберите нужный раздел сайта."
>
	<section class="ds relative isolate overflow-hidden border-b border-neutral-200 bg-white">

		<div class="mx-auto grid min-h-[72vh] max-w-[1440px] items-center gap-12 px-6 py-20 sm:py-24 lg:grid-cols-[minmax(0,1fr)_420px] lg:py-28">
			<div class="max-w-4xl">

				<Breadcrumbs current="Страница не найдена" />
<h1 class="mt-4 max-w-4xl text-4xl font-semibold leading-[1.06] text-neutral-950 sm:text-5xl lg:text-6xl">
					Такой страницы в системе нет
				</h1>
				<p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-700 sm:text-xl">
					Ссылка устарела, адрес набран с ошибкой или страница была перенесена.
					Поможем быстро вернуться к нужному разделу.
				</p>

				<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
					<a href="/" class="ds-btn ds-btn-primary w-full sm:w-auto">
						<span>На главную</span>
						<UiIcon name="arrow-alt-24" class="h-[28px] w-[28px]" />
					</a>
					<button
						class="consultation-trigger inline-flex min-h-11 w-full items-center justify-center rounded-full border border-neutral-300 bg-white px-7 text-sm font-bold text-neutral-900 transition hover:border-indigo-500 hover:text-indigo-600 sm:w-auto"
						type="button"
						data-b24-form-trigger
					>
						Бесплатная консультация
					</button>
				</div>
			</div>

			<div class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-[0_24px_70px_rgba(15,23,42,0.14)]">
				<p class="text-sm font-medium text-neutral-500">Быстрый переход</p>
				<div class="service-card-row mt-4 grid gap-3">
					{quickLinks.map((link) => (
						<a
							href={link.href}
							class="group block rounded-xl border border-neutral-200 bg-white p-4 transition hover:border-indigo-500"
						>
							<span class="flex items-center justify-between gap-4">
								<span class="text-base font-semibold text-neutral-950">{link.title}</span>
								<span class="inline-flex shrink-0">
									<UiIcon name="arrow-up-right-24" class="h-[28px] w-[28px]" />
								</span>
							</span>
							<span class="mt-2 block text-sm leading-6 text-neutral-600">
								{link.description}
							</span>
						</a>
					))}
				</div>
			</div>
		</div>
	</section>
<ServiceCta title="Поможем найти решение вашей задачи" text="Если нужной страницы не оказалось, расскажите о своём проекте. Подскажем, с какой услуги начать." />
</Layout>
