# Build-time settings (export explicitly; this file is not loaded automatically).
DEPLOY_ENV=staging
SITE_URL=https://ittimenow-ittn-020d.twc1.net

# Production: DEPLOY_ENV=production SITE_URL=https://ittimenow.com
# VPS compose: ITTN_IMAGE=ittn:<verified-release-tag>

# Runtime drawing storage and SMTP. Export these for npm start / npm run dev.
# Docker Compose: SMTP settings go into server-side mail.env (not the release .env).
IDEA_STORAGE_DIR=/app/data/ideas
IDEA_PUBLIC_ORIGIN=https://ittimenow.com
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
IDEA_TRUST_PROXY=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# SMTP recipient is fixed in code: pm@ittimenow.com.
